set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
"$root/hack/venue-check"

record_status() {
    local code=$1
    if [[ -n ${CONFORMANCE_STATUS_FILE:-} ]]; then
        printf '%s\n' "$code" >| "$CONFORMANCE_STATUS_FILE" || :
    fi
}

if command -v claude >/dev/null; then
    printf '%s\n' 'claude resolves on venue PATH' >&2
    record_status 1
    exit 1
fi
max_limit=${MAX_TIMEOUT_SECONDS:-200}
if ! [[ $max_limit =~ ^[1-9][0-9]{0,3}$ && $max_limit -le 1800 ]]; then
    printf 'MAX_TIMEOUT_SECONDS must be between 1 and 1800\n' >&2
    record_status 2
    exit 2
fi
limit=${TIMEOUT_SECONDS:-200}
if ! [[ $limit =~ ^[1-9][0-9]{0,3}$ && $limit -le $max_limit ]]; then
    printf 'TIMEOUT_SECONDS must be between 1 and %s\n' "$max_limit" >&2
    record_status 2
    exit 2
fi
umask 077
mkdir -p "$root/.cache"
work=$(mktemp -d "$root/.cache/conformance.XXXXXXXX")
tmp=''

# Invoked by the EXIT trap.
# shellcheck disable=SC2329
cleanup() {
    local rc=$?
    record_status "$rc"
    if [[ -n $tmp ]]; then rm -rf -- "$tmp"; fi
    if (( rc == 0 )); then rm -rf -- "$work"; else printf 'conformance: diagnostics retained in %s\n' "$work" >&2; fi
    exit "$rc"
}
trap cleanup EXIT
tmp=$(mktemp -d "${root%/*}/t.XXXXXX")
mkdir "$work/home"

rc=0
interrupted=0
trap 'interrupted=1' HUP INT TERM
python3 -I "$root/hack/conformance-supervise" "$work" "$limit" \
    bash "$root/hack/conformance-job" "$root" "$work" "$tmp" 9<&- &
pid=$!
trap 'interrupted=1; kill -TERM "$pid" 2>/dev/null || :' HUP INT TERM
if (( interrupted )); then kill -TERM "$pid" 2>/dev/null || :; fi
wait "$pid" || rc=$?
if (( interrupted )); then trap '' HUP INT TERM; wait "$pid" || :; rc=1; fi
if [[ -f $work/job.log ]]; then cat -- "$work/job.log"; fi
if [[ ${MODE:-suite} == self-test && $rc == 0 && ${CONFORMANCE_SKIP_CONTAINMENT_CHECK:-0} != 1 ]]; then
    "$root/hack/conformance-containment-check" "$root" 9<&- || rc=$?
fi
"$root/hack/venue-check"
exit "$rc"

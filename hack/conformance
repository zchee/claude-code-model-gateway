set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
"$root/hack/venue-check" || exit 97
if [[ ${CONFORMANCE_VENUE_SCOPED:-0} != 1 ]]; then
    printf '%s\n' 'conformance: standalone containment is best effort (process group only); detached children require runner disposal' >&2
fi
if command -v claude >/dev/null; then printf 'claude resolves on venue PATH\n' >&2; exit 97; fi
max_limit=${MAX_TIMEOUT_SECONDS:-200}
if ! [[ $max_limit =~ ^[1-9][0-9]{0,3}$ && $max_limit -le 1800 ]]; then
    printf 'MAX_TIMEOUT_SECONDS must be between 1 and 1800\n' >&2; exit 2
fi
limit=${TIMEOUT_SECONDS:-200}
if ! [[ $limit =~ ^[1-9][0-9]{0,3}$ && $limit -le $max_limit ]]; then
    printf 'TIMEOUT_SECONDS must be between 1 and %s\n' "$max_limit" >&2; exit 2
fi
target=${TARGET:-identity}
bash "$root/hack/conformance-selection" "$root/test/conformance/classification.tsv" "TARGET=$target" "MODE=${MODE:-suite}" \
    "SITE=${SITE:-}" "CLASS=${CLASS:-}" "PHASE=${PHASE:-}" "PACKAGE=${PACKAGE:-}" "GATE=${GATE:-}"
if [[ $target != identity ]]; then
    bin=${target#binary:}
    [[ -f $bin && -x $bin && $(realpath "$bin") == "$bin" ]] || { printf 'invalid executable: %s\n' "$bin" >&2; exit 2; }
fi
umask 077
trap 'exit 70' ERR
mkdir -p "$root/.cache"
work=$(mktemp -d "$root/.cache/conformance.XXXXXXXX")
tmp=''
interrupted=0
trap 'interrupted=129' HUP
trap 'interrupted=130' INT
trap 'interrupted=143' TERM
# Invoked by the EXIT trap.
# shellcheck disable=SC2329
cleanup() {
    local rc=$? cleanup_rc=0
    trap - ERR EXIT
    if [[ -n $tmp ]]; then rm -rf -- "$tmp" || cleanup_rc=70; fi
    if (( rc == 0 )); then rm -rf -- "$work" || cleanup_rc=70
    else printf 'conformance: diagnostics retained in %s\n' "$work" >&2; fi
    if (( rc == 0 && cleanup_rc )); then rc=$cleanup_rc; fi
    if (( rc != 124 && interrupted )); then rc=$interrupted; fi
    exit "$rc"
}
trap cleanup EXIT
tmp=$(mktemp -d "${root%/*}/t.XXXXXX")
mkdir "$work/home"
rc=0
python3 -I "$root/hack/conformance-supervise" "$work" "$limit" \
    bash "$root/hack/conformance-job" "$root" "$work" "$tmp" 9<&- || rc=$?
if [[ -f $work/job.log ]]; then cat -- "$work/job.log" || { (( rc )) || rc=70; }; fi
if [[ ${MODE:-suite} == self-test && $rc == 0 && $interrupted == 0 ]]; then
    "$root/hack/conformance-containment-check" "$root" "$work" >| "$work/controls.log" 9<&- || rc=$?
    cat "$work/controls.log" || { (( rc )) || rc=70; }
    for name in selector-refusal timeout-ceiling private-status in-group-timeout; do
        count=$(grep -Fxc "# containment control $name: pass" "$work/controls.log" || :)
        [[ $count == 1 ]] || { printf 'unverified control: %s\n' "$name" >&2; (( rc )) || rc=1; }
    done
fi
"$root/hack/venue-check" || { (( rc )) || rc=97; }
exit "$rc"

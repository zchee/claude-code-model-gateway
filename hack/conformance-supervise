"""Run the conformance suite with non-reaping process-group containment."""

import os
import signal
import subprocess
import sys
import time
from pathlib import Path

interrupted = False


def interrupt(_signal: int, _frame: object) -> None:
    """Request shutdown without interrupting process creation."""
    global interrupted
    interrupted = True


def snapshot() -> set[tuple[int, int]]:
    """Identify live Linux account processes by PID and kernel start tick."""
    result: set[tuple[int, int]] = set()
    uid = os.getuid()
    bus = (
        f"0::/user.slice/user-{uid}.slice/user@{uid}.service/session.slice/dbus.service"
    )
    for entry in Path("/proc").glob("[0-9]*"):
        try:
            if entry.stat().st_uid != uid:
                continue
            fields = (entry / "stat").read_bytes().rsplit(b")", 1)[1].split()
            if fields[0] == b"Z":
                continue
            if (entry / "cgroup").read_text().strip() == bus and os.path.samefile(
                entry / "exe", "/usr/bin/dbus-daemon"
            ):
                continue
            result.add((int(entry.name), int(fields[19])))
        except (FileNotFoundError, ProcessLookupError):
            continue
    return result


def active_test_files(work: Path) -> str:
    """Read currently active test file markers written by the preload."""
    active: list[str] = []
    for marker in sorted(work.glob("active-*")):
        try:
            active.append(marker.read_text())
        except FileNotFoundError:
            continue
    return ", ".join(active) or "(none registered)"


def wait_leader_nonreaping(pid: int) -> bool:
    """Return True when pid has exited without reaping it (keeps PGID non-reusable)."""
    info = os.waitid(os.P_PID, pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)
    return info is not None


def live_pgid_members(pgid: int) -> list[int]:
    """Return non-zombie PIDs currently belonging to process group pgid."""
    res = subprocess.run(
        ["ps", "-eo", "pid=,pgid=,stat="],
        capture_output=True,
        text=True,
        check=False,
    )
    if res.returncode != 0:
        return [pgid]
    members: list[int] = []
    for line in res.stdout.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        try:
            pid = int(parts[0])
            grp = int(parts[1])
        except ValueError:
            continue
        if grp == pgid and not parts[2].startswith("Z"):
            members.append(pid)
    return members


def stop_pgid_before_reap(job: subprocess.Popen[bytes], initial_rc: int | None) -> int:
    """Signal a process group before reaping its leader so the PGID cannot be reused."""
    rc = initial_rc
    for sig in (signal.SIGTERM, signal.SIGKILL):
        if not live_pgid_members(job.pid):
            break
        try:
            os.killpg(job.pid, sig)
        except ProcessLookupError:
            break
        print(
            f"conformance: sending {sig.name} to suite group {job.pid}", file=sys.stderr
        )
        rc = rc if rc not in (None, 0) else 1
        grace_deadline = time.monotonic() + 3.0
        while time.monotonic() < grace_deadline:
            if not live_pgid_members(job.pid):
                break
            time.sleep(0.05)
        else:
            continue
        break
    else:
        if live_pgid_members(job.pid):
            job.wait()
            sys.exit("conformance: suite process group survived termination")
    reaped = job.wait()
    return rc if rc is not None else reaped


def main() -> None:
    """Entry point for running a process-group-contained conformance job."""
    if len(sys.argv) < 4:
        sys.exit("usage: conformance-supervise WORK LIMIT CMD [ARGS...]")
    if not (hasattr(os, "waitid") and hasattr(os, "WNOWAIT")):
        sys.exit(
            "conformance: os.waitid with WNOWAIT is required for safe process-group containment"
        )

    for sig in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, interrupt)

    linux = sys.platform == "linux"
    work = Path(sys.argv[1])
    limit = int(sys.argv[2])
    job_cmd = sys.argv[3:]

    deadline = time.monotonic() + limit
    before = snapshot() if linux else set()

    # Detached fixture processes cannot hold the remote transport's pipes open.
    with (work / "job.log").open("xb") as output:
        job = subprocess.Popen(
            job_cmd,
            start_new_session=True,
            stdout=output,
            stderr=subprocess.STDOUT,
        )

    exited = False
    while not interrupted and time.monotonic() < deadline:
        if wait_leader_nonreaping(job.pid):
            exited = True
            break
        time.sleep(0.05)

    timed_out = not interrupted and not exited
    if interrupted or timed_out:
        rc = 1 if interrupted else 124
        reason = (
            "interrupted"
            if interrupted
            else f"wall-clock limit {limit}s reached (infrastructure timeout)"
        )
        print(
            f"conformance: {reason}; active test files: {active_test_files(work)}",
            file=sys.stderr,
        )
        rc = stop_pgid_before_reap(job, rc)
    else:
        # Keep leader unreaped until any stray group members are checked/signaled.
        rc = stop_pgid_before_reap(job, None)

    if linux:
        leftover = snapshot() - before
        if leftover:
            print(
                f"conformance: new live account processes (pid, start tick): {sorted(leftover)}",
                file=sys.stderr,
            )
            if not timed_out:
                rc = 1
        else:
            print("# conformance containment: no new live account processes")

    sys.exit(rc if rc >= 0 else 128 - rc)


if __name__ == "__main__":
    main()

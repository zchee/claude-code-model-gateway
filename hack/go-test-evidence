set -euC

fail() { printf 'go-test-evidence: %s\n' "$*" >&2; exit 1; }

case $0 in
    */*) script_dir=${0%/*} ;;
    *)
        [ -f "./$0" ] || fail 'bare script path is not a regular file in the current directory'
        script_dir=.
        ;;
esac

[ "$#" -eq 3 ] || fail 'usage: hack/go-test-evidence {plain|process} RUN_ID OUTPUT'
case $1 in
    plain) target=test-json ;;
    process) target=test-process-json ;;
    *) fail 'suite must be plain or process' ;;
esac
case $2 in
    ''|*[!a-zA-Z0-9_-]*) fail 'run ID must contain only letters, digits, hyphens or underscores' ;;
esac
[ -n "$3" ] || fail 'missing output path'

[ ! -L "$0" ] || fail 'script must not be a symbolic link'
# A sentinel keeps command substitution from trimming newlines in the root name.
root=$(CDPATH='' cd -P -- "$script_dir/.." && pwd -P && printf .) || fail 'cannot resolve checkout root'
root=${root%??}
# Do not let the caller's Git or make context redirect this checkout or its guard.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR MAKEFLAGS GNUMAKEFLAGS MFLAGS MAKEFILES
commit=$(git -C "$root" rev-parse --verify HEAD) || fail 'cannot resolve checkout commit'
status=$(git --no-optional-locks -C "$root" status --porcelain --untracked-files=all) || fail 'cannot check worktree status'
[ -z "$status" ] || fail 'worktree must be clean'

make_in_tree() { make --no-print-directory -C "$root" -f "$root/Makefile" "$@"; }
require_new_output() {
    if [ -e "$1" ] || [ -L "$1" ]; then
        fail 'output path already exists'
    fi
}

require_new_output "$3"
make_in_tree check-test-venue
raw=
trap 'if [ -n "$raw" ]; then rm -f -- "$raw"; fi' EXIT
trap 'exit 1' HUP INT TERM
raw=$(mktemp "${TMPDIR:-/tmp}/go-test-evidence.XXXXXXXX")
rc=
make_in_tree "$target" >| "$raw" || rc=$?
# A refusal at the repeated venue check emits no events.
if [ ! -s "$raw" ]; then
    [ -z "$rc" ] || exit "$rc"
    fail 'test suite succeeded without emitting Go events'
fi
require_new_output "$3"
{
    printf '{"run_id":"%s","commit":"%s"}\n' "$2" "$commit" &&
        cat -- "$raw"
} > "$3" || rc=${rc:-$?}
exit "${rc:-0}"

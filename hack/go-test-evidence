set -euC

fail() { printf 'go-test-evidence: %s\n' "$*" >&2; exit 1; }

[ "$#" -eq 3 ] || fail 'usage: hack/go-test-evidence {plain|process} RUN_ID OUTPUT'
case $1 in
    plain) target=test-json ;;
    process) target=test-process-json ;;
    *) fail 'suite must be plain or process' ;;
esac
case $2 in
    ''|*[!a-zA-Z0-9_-]*) fail 'run ID must contain only letters, digits, hyphens or underscores' ;;
esac
[ -n "$3" ] || fail 'missing output path'

commit=$(git rev-parse --verify HEAD) || fail 'cannot resolve checkout commit'
status=$(git status --porcelain --untracked-files=all) || fail 'cannot check worktree status'
[ -z "$status" ] || fail 'worktree must be clean'

{
    printf '{"run_id":"%s","commit":"%s"}\n' "$2" "$commit" &&
        make --no-print-directory "$target"
} > "$3"

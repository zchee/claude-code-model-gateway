set -euo pipefail
root=$1 work=$2
"$root/hack/venue-check" || exit 97
expect_usage() {
    local expected=$1 rc=0; shift
    "$root/hack/remote" "$@" >| "$work/usage.log" 2>&1 || rc=$?
    if [[ $rc != 2 ]] || ! grep -Fq "$expected" "$work/usage.log"; then
        printf 'expected usage error (%s), got %s\n' "$expected" "$rc" >&2
        return 1
    fi
}
expect_usage 'probe mode does not accept case selectors' run conformance MODE=probes PACKAGE=internal/supervisor
expect_usage 'empty conformance selection' run conformance PACKAGE=absent-package
printf '# containment control selector-refusal: pass\n'
expect_usage 'TIMEOUT_SECONDS must be between 1 and 200' run test conformance TIMEOUT_SECONDS=201
printf '# containment control timeout-ceiling: pass\n'
mkdir "$work/control-group"
rc=0
# The controlled shell, not this shell, writes its PID before exec.
# shellcheck disable=SC2016
python3 -I "$root/hack/conformance-supervise" "$work/control-group" 1 /bin/sh -c \
    'printf "%s\n" "$$" > "$1"; exec sleep 30' sh "$work/control-group/child" || rc=$?
[[ $rc == 124 && -s $work/control-group/child ]] || exit 1
if kill -0 "$(<"$work/control-group/child")" 2>/dev/null; then printf 'in-group child survived\n' >&2; exit 1; fi
printf '# containment control in-group-timeout: pass\n'

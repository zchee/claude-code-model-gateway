set -euo pipefail

commit=a8501f25175572071a0d085d34346dcf67e49b23
root_tree=22be5dae8859c7307906f938fa364b7ffadf006c
plugin_tree=aaf4f26b527c2ff08dbc47707a5f69e6ec2cf40a
source_repo=https://github.com/zchee/eigenwise-toolshed

fail() {
    printf 'pinned-source: %s\n' "$*" >&2
    exit 1
}

if [[ $# == 2 && $1 == --from && -n $2 ]]; then
    source_repo=$2
elif [[ $# != 0 ]]; then
    fail 'usage: pinned-source [--from <local checkout or URL>]'
fi

root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cache=$root/.cache
export_dir=$cache/model-gateway-js
lock=$cache/model-gateway-js.lock
[[ ! -L $cache ]] || fail "cache directory is a symlink: $cache"
mkdir -p -- "$cache" || fail "cannot create cache directory: $cache"
tmp=$(mktemp -d "$cache/pinned-source.XXXXXXXX") || fail 'cannot create staging directory'
locked=0
cleanup() {
    if (( locked )); then
        mv -- "$lock" "$tmp/released-lock" || printf 'pinned-source: cannot release cache lock: %s\n' "$lock" >&2
    fi
    rm -rf -- "$tmp"
}
trap cleanup EXIT

# Defer signals until the owner marker and the cleanup flag have both been set.
interrupted=0
trap 'interrupted=1' HUP INT TERM
host=$(hostname) || fail 'cannot determine lock hostname'
for (( attempt = 0; attempt < 60; attempt++ )); do
    (( ! interrupted )) || exit 1
    if mkdir -- "$lock" 2>/dev/null; then
        locked=1
        printf '%s\n' "$host" > "$lock/owner.$$" || fail 'cannot record cache lock owner'
        break
    fi
    [[ ! -L $lock ]] || fail "cache lock is a symlink: $lock"
    [[ ! -e $lock || -d $lock ]] || fail "cannot acquire cache lock: $lock"
    for owner in "$lock"/owner.*; do
        [[ -f $owner && ! -L $owner ]] || continue
        pid=${owner##*.}
        case $pid in ''|*[!0-9]*|0) continue ;; esac
        IFS= read -r owner_host 2>/dev/null < "$owner" || continue
        [[ $owner_host == "$host" ]] || continue
        if ! ps -p "$pid" -o pid= >/dev/null 2>&1; then
            # Transfer the specific dead PID's marker, not the lock directory:
            # concurrent waiters cannot move the same marker twice.
            if mv -- "$owner" "$lock/owner.$$" 2>/dev/null; then
                locked=1
                break 2
            fi
        fi
    done
    sleep 1
done
(( locked )) || fail "timed out waiting for cache lock: $lock"
trap 'exit 1' HUP INT TERM
(( ! interrupted )) || exit 1

git_dir=$tmp/source.git
staging=$tmp/model-gateway-js

# Start Git without the caller's config, object paths, or pathspec settings.
git_env() {
    env -i PATH="$PATH" HOME="$tmp" TMPDIR="$tmp" LC_ALL=C \
        GIT_CONFIG_NOSYSTEM=1 GIT_ATTR_NOSYSTEM=1 GIT_NO_REPLACE_OBJECTS=1 GIT_TERMINAL_PROMPT=0 "$@"
}
git_env git init --quiet --bare --template= --object-format=sha1 -- "$git_dir" || fail 'cannot initialize temporary repository'
repo_git() {
    git_env git --git-dir="$git_dir" -c core.autocrlf=false -c core.filemode=true -c core.symlinks=true "$@"
}

check_trees() {
    local tree=$1 label=$2 plugin
    if [[ $tree != "$root_tree" ]]; then
        printf 'pinned-source: %s root tree is %s, expected %s\n' "$label" "$tree" "$root_tree" >&2
        return 1
    fi
    plugin=$(repo_git rev-parse --verify "$tree:plugins/model-gateway") || return 2
    if [[ $plugin != "$plugin_tree" ]]; then
        printf 'pinned-source: %s plugin tree is %s, expected %s\n' "$label" "$plugin" "$plugin_tree" >&2
        return 1
    fi
}

# Unlike archive, checkout-index ignores export attributes. These higher-priority
# attributes disable byte conversions in both checkout-index and add.
mkdir -- "$git_dir/info"
printf '%s\n' '* -text -crlf -ident -filter -working-tree-encoding' > "$git_dir/info/attributes"

verify_export() (
    local dir=$1 path kind invalid=0 tree entry
    cd -- "$dir" || return 2
    # Git may skip both unreadable directories and entries it cannot index. Walk
    # the whole directory and read every regular file before judging validity.
    find -P . -print0 -type f -exec sh -c 'cat "$@" >/dev/null' sh {} + > "$tmp/paths" || return 2
    while IFS= read -r -d '' path; do
        case $path in
            .) continue ;;
            */.[gG][iI][tT]|*/.[gG][iI][tT]/*) invalid=1 ;;
        esac
        if [[ -L $path ]]; then
            readlink -- "$path" >/dev/null || return 2
            kind=l
        elif [[ -d $path ]]; then
            [[ -r $path && -x $path ]] || return 2
            kind=d
        elif [[ -f $path ]]; then
            kind=f
        elif [[ -e $path ]]; then
            invalid=1
            continue
        else
            return 2
        fi
        printf '%s %s\0' "$kind" "${path#./}" || return 2
    done < "$tmp/paths" > "$tmp/disk-entries" || return 2
    if (( invalid )); then
        printf 'pinned-source: unexpected filesystem entries in %s\n' "$dir" >&2
        return 1
    fi

    # A fresh index makes Git hash the filesystem contents rather than reuse entries.
    rm -f -- "$git_dir/index" || return 2
    repo_git --work-tree="$dir" add --force --all -- . || return 2
    tree=$(repo_git write-tree) || return 2
    check_trees "$tree" "$dir" || return "$?"

    repo_git ls-tree -rtz --format='%(objectmode) %(path)' "$tree" > "$tmp/tree-paths" || return 2
    while IFS= read -r -d '' entry; do
        case ${entry%% *} in
            040000) kind=d ;;
            100644|100755) kind=f ;;
            120000) kind=l ;;
            *) return 1 ;;
        esac
        printf '%s %s\0' "$kind" "${entry#* }" || return 2
    done < "$tmp/tree-paths" > "$tmp/tree-entries" || return 2
    LC_ALL=C sort -z "$tmp/disk-entries" > "$tmp/disk-sorted" || return 2
    LC_ALL=C sort -z "$tmp/tree-entries" > "$tmp/tree-sorted" || return 2
    cmp -s "$tmp/disk-sorted" "$tmp/tree-sorted"
)

if [[ -d $export_dir && ! -L $export_dir ]]; then
    status=0
    verify_export "$export_dir" || status=$?
    case $status in
        0) printf '%s\n' "$export_dir"; exit 0 ;;
        1) ;; # The directory was read successfully but did not match the pin.
        *) fail "cannot verify existing export: $export_dir" ;;
    esac
fi
if [[ -e $export_dir || -L $export_dir ]]; then
    printf 'pinned-source: replacing invalid export: %s\n' "$export_dir" >&2
    mv -- "$export_dir" "$tmp/invalid-export" || fail "cannot move invalid export: $export_dir"
fi

# Only the fetch gets transport settings from the caller.
git_env http_proxy="${http_proxy-}" https_proxy="${https_proxy-}" all_proxy="${all_proxy-}" no_proxy="${no_proxy-}" \
    HTTP_PROXY="${HTTP_PROXY-}" HTTPS_PROXY="${HTTPS_PROXY-}" ALL_PROXY="${ALL_PROXY-}" NO_PROXY="${NO_PROXY-}" \
    SSH_AUTH_SOCK="${SSH_AUTH_SOCK-}" git --git-dir="$git_dir" \
    fetch --quiet --depth=1 --no-tags --no-recurse-submodules -- "$source_repo" "$commit" ||
    fail "cannot fetch pinned commit $commit from $source_repo"
object_tree=$(repo_git rev-parse --verify "$commit^{tree}") || fail 'cannot resolve pinned commit tree'
check_trees "$object_tree" 'pinned commit' || exit 1

mkdir -- "$staging" || fail 'cannot create staging tree'
repo_git read-tree "$object_tree" || fail 'cannot load pinned tree into index'
repo_git --work-tree="$staging" checkout-index --all --prefix="$staging/" || fail 'cannot export pinned tree'
verify_export "$staging" || fail 'exported files do not reproduce the pinned tree'
mv -- "$staging" "$cache/" || fail "cannot publish export: $export_dir"
printf '%s\n' "$export_dir"

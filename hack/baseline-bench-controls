def rule_breaks(record):
    """Name the half-close client rules the record breaks."""
    c, broken = record['client'], set()
    errors = [e for e in record['events'] if e['event'] == 'client-error']
    if c['errorCode'] != (errors[-1].get('code') if errors else None):
        broken.add('error-code')
    if any(not isinstance(e.get('code'), str) for e in errors):
        broken.add('error-code-type')
    if c['errorCode'] == 'ECONNRESET':
        end = 'reset'
    elif c['errorCode'] is not None:
        end = 'error'
    else:
        end = 'orderly' if c['inputEndMs'] is not None else 'open'
    if c['end'] != end:
        broken.add('end')
    complete = bool(c['bodyMatches'] and c['framingError'] is None and c['terminated'] is not False and
                    (c['terminated'] is True or c['end'] == 'orderly'))
    if c['bodyComplete'] is not complete:
        broken.add('body-complete')
    if c['head'] is None:
        if (c['framing'], c['bodyBytes'], c['terminated'], c['framingError'], c['excessBytes'], c['bodyMatches']) != \
                (None, 0, False, None, 0, False) or c['terminated'] is not False or c['bodyMatches'] is not False:
            broken.add('head')
    elif c['framing'] is None or c['statusLine'] != c['head'].split('\r\n', 1)[0]:
        broken.add('head')
    if c['head'] is None and c['wireBytes'] > 0 and not isinstance(c['statusLine'], str):
        broken.add('head')
    if (c['framing'] == 'close') != (c['terminated'] is None):
        broken.add('close-framing')
    if c['wireBytes'] == 0 and (c['statusLine'] is not None or c['head'] is not None or c['wireSHA256'] != EMPTY_SHA256):
        broken.add('empty-wire')
    return broken


def contradiction(rule, match, *changes):
    # Changes to one committed record that break exactly the named rules (none for a consistent variant).
    def mutate(records):
        records = copy.deepcopy(records)
        r = first(records, 'half-close', **match)
        for change in changes:
            change(r)
        if rule_breaks(r) != ({rule} if rule else set()):
            fail(f'the {rule or "consistent"} variant breaks {sorted(rule_breaks(r))}')
        return records
    return mutate


def error_event(**fields):
    def change(record):
        record['events'].append(dict({'event': 'client-error', 'offsetMs': record['events'][-1]['offsetMs'] + 1},
                                     **fields))
    return change


PARTIAL_WIRE = b'\r\n'


def partial_wire(record):
    # The client received two bytes and no complete head: the wire, its digest, its data event and first byte agree.
    c = record['client']
    at = next(i for i, e in enumerate(record['events']) if e['event'] == 'client-input-end')
    offset = (record['events'][at - 1]['offsetMs'] + record['events'][at]['offsetMs']) / 2
    record['events'].insert(at, {'event': 'client-data', 'bytes': len(PARTIAL_WIRE), 'offsetMs': offset})
    c.update(wireBytes=len(PARTIAL_WIRE), wireSHA256=hashlib.sha256(PARTIAL_WIRE).hexdigest(),
             statusLine=PARTIAL_WIRE.decode('latin1').split('\r\n')[0], firstByteMs=offset)


def client_error(record):
    record['events'].append({'event': 'client-error', 'code': 'ECONNRESET',
                             'offsetMs': record['events'][-1]['offsetMs'] + 1})


def pad_record(raw, size):
    # JSON allows whitespace between tokens: spaces after the first brace make the records exactly size bytes.
    if size < len(raw):
        fail(f'cannot pad {len(raw)} bytes down to {size}')
    return raw[:1] + b' ' * (size - len(raw)) + raw[1:]


def pad_output(output, size):
    # Log lines in front of the frame make a run output exactly size bytes.
    missing = size - len(output)
    lines = []
    while missing:
        n = min(missing, 1 << 20)
        if missing - n == 1:
            n -= 1
        if n < 2:
            fail(f'cannot pad a run output to {size} bytes')
        lines.append(b'bench: ' [:n - 1].ljust(n - 1, b'.') + b'\n')
        missing -= n
    return b''.join(lines) + output


def grower(path):
    # Extends the file, as a writer appending zeros would, until the limit.
    def tick():
        size = path.stat().st_size
        if size < GROWTH_LIMIT:
            os.truncate(path, min(size + GROWTH_STEP, GROWTH_LIMIT))
    return tick


def unchanged(path, data, link=None):
    def post():
        if link is not None and not os.path.islink(link):
            return 'replaced-the-symlink'
        if data is None:
            return 'created-the-target' if os.path.lexists(path) else None
        return None if path.read_bytes() == data else 'changed-the-file'
    return post



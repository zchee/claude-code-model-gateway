def containment_sentence():
    # The plan states the contract once, in curly quotes, wrapped across lines.
    text = (ROOT / 'docs/port/model-gateway-go-port.md').read_text(encoding='utf-8')
    found = re.findall(r'records the result as “([^”]+)”', text)
    if len(found) != 1:
        fail(f'the plan states the macOS containment contract {len(found)} times, expected once')
    return ' '.join(found[0].split())


def load(name):
    raw = (SAMPLES / name).read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    if digest != SAMPLE_SHA256[name]:
        fail(f'{name} has SHA-256 {digest}, not the one docs/port/baseline-node.md records')
    return raw, [json.loads(line) for line in raw.split(b'\n')[:-1]]


def encode(records):
    # The committed samples are exactly this serialization of their records.
    return b''.join((json.dumps(r, ensure_ascii=False, separators=(',', ':')) + '\n').encode() for r in records)


def frame_line(payload):
    return b'NODE-BENCH-V1 ' + hashlib.sha256(payload).hexdigest().encode() + b' ' + base64.b64encode(payload) + b'\n'


def run_output(raw):
    return payload_output(gzip.compress(raw, mtime=0))


def payload_output(payload):
    return b'bench: launching the pinned harness\n' + frame_line(payload) + b'bench: subreaper has no remaining children\n'


def two_members(raw):
    # Both halves end at a record boundary; a reader that joins members sees the whole run.
    middle = raw.index(b'\n', len(raw) // 2) + 1
    return gzip.compress(raw[:middle], mtime=0) + gzip.compress(raw[middle:], mtime=0)


def padded_member(raw, encoded):
    # One gzip member whose header comment (FCOMMENT) pads its base64 text to encoded bytes; it still decodes to raw.
    packer = zlib.compressobj(9, zlib.DEFLATED, -15)
    body = packer.compress(raw) + packer.flush()
    trailer = struct.pack('<II', zlib.crc32(raw), len(raw) & 0xffffffff)
    fixed = 10 + 1 + len(body) + len(trailer)
    header = b'\x1f\x8b\x08\x10' + bytes(4) + b'\x00\xff'
    return header + b'x' * (encoded * 3 // 4 - fixed) + b'\x00' + body + trailer


def with_literal(records, path, literal):
    # json.dumps cannot write an overflowing literal such as 1e999, so a marker string stands in for it.
    records = copy.deepcopy(records)
    target = records[0]
    for k in path[:-1]:
        target = target[k]
    target[path[-1]] = '\u0000literal'
    return encode(records).replace(b'"\\u0000literal"', literal, 1)


def of_type(records, kind):
    return [r for r in records if r['type'] == kind]


def first(records, kind, **match):
    for r in records:
        if r['type'] == kind and all(r.get(k) == v for k, v in match.items()):
            return r
    fail(f'no {kind} record matches {match}')


def end_record(records):
    return first(records, 'end')


def darwinize(records, sentence):
    records = copy.deepcopy(records)
    run = records[0]
    # A macOS run takes its UTC stamps from perl, to the microsecond.
    for r in records:
        for k in ('started', 'ended', 'at'):
            if isinstance(r.get(k), str):
                r[k] = re.sub(r'(\.[0-9]{6})[0-9]{3}Z$', r'\1Z', r[k])
    run['commands'].update(DARWIN_COMMANDS)
    run['machine'].update(copy.deepcopy(DARWIN_MACHINE))
    for r in of_type(records, 'rss'):
        r['metric'] = DARWIN_RSS
    records.append({'type': 'cleanup', 'checked': '2026-11-27T12:00:00.000000Z', 'containment': sentence,
                    'observations': copy.deepcopy(OBSERVATIONS)})
    return records



    s = records[0]['settings']
    s['series'] = 2
    end_record(records)['usagePosts'] = s['series'] * (s['warmups'] + s['ttfbRuns'])
    return records


def fewer_samples(kind, field):
    def mutate(records):
        records = copy.deepcopy(records)
        s = records[0]['settings']
        last = s['warmups'] + s[field] - 1
        records = [r for r in records if not (r['type'] == kind and r['sample'] == last)]
        records[0]['settings'][field] -= 1
        s = records[0]['settings']
        end_record(records)['usagePosts'] = s['series'] * (s['warmups'] + s['ttfbRuns'])
        return records
    return mutate



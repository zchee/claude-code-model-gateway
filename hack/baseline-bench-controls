# Negative and positive controls for hack/baseline-bench. Every case is built by
# mutation from the committed Linux samples in a private temporary directory;
# the checker runs on it and must give the stated verdict. Nothing here starts
# Node, a gateway or the bench.
#
#   baseline-bench-controls [--without-platform] [<checker>]
#       <checker> defaults to hack/baseline-bench next to this script.
#       --without-platform calls verify, check and summary without the
#       --platform option, for a checker that predates it; the controls that exist only
#       through that option are then listed as not expressible.
#
# The option is passed as `verify --platform <p> <mode> ...`,
# `check --platform <p> <mode> ...` and `summary --platform <p> <file>`. Each control prints one line; the exit
# status is 1 when any observed verdict differs from the expected one.
#
# The oversized inputs are sparse files and a gzip stream fed in chunks, so
# building them costs neither disk nor memory here. A checker run gets a
# deadline and is killed with its process group when it passes it; its peak
# resident memory, including its own children, comes from wait4.

set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
python3 -I - "$root" "$@" <<'PY'

set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
"$root/hack/venue-check"
# Every fixture listens on a port the kernel picks from its ephemeral range.
system=$(uname -s)
case $system in
    Linux)
        read -r low high < /proc/sys/net/ipv4/ip_local_port_range
        ranges=("$low $high")
        ;;
    Darwin)
        # A bind to port zero draws from the default range; the high range
        # serves sockets that ask for it. Neither may reach a gateway port.
        # The kernel allocates downward when first exceeds last, so a pair
        # names the same ports in either order.
        ranges=()
        for range in portrange.first,portrange.last portrange.hifirst,portrange.hilast; do
            low=$(/usr/sbin/sysctl -n "net.inet.ip.${range%,*}") && high=$(/usr/sbin/sysctl -n "net.inet.ip.${range#*,}") &&
                [[ $low =~ ^[0-9]+$ && $high =~ ^[0-9]+$ ]] ||
                { printf 'bench: cannot read net.inet.ip.%s\n' "${range%,*}" >&2; exit 1; }
            if (( low > high )); then ranges+=("$high $low"); else ranges+=("$low $high"); fi
        done
        ;;
    *) printf 'not a test venue: bench requires Linux or macOS\n' >&2; exit 97 ;;
esac
for range in "${ranges[@]}"; do
    read -r low high <<< "$range"
    for port in 80 18764 18765; do
        (( port < low || port > high )) || { printf 'bench: ephemeral range includes forbidden port %s\n' "$port" >&2; exit 1; }
    done
done
if command -v claude >/dev/null; then printf 'bench: claude resolves on venue PATH\n' >&2; exit 1; fi
# An empty selection runs the whole baseline; half-close runs only that probe.
case ${BENCH_PROBE-} in
    ''|half-close) ;;
    *) printf 'bench: unknown BENCH_PROBE: %s\n' "$BENCH_PROBE" >&2; exit 2 ;;
esac
# The hosted macOS runner keeps each attempt's diagnostics and partial samples
# here as they are written; the directory must be new and empty so that it
# holds one attempt only. Other systems ignore it.
artifact=''
if [[ $system == Darwin ]]; then artifact=${BENCH_ARTIFACT_DIR-}; fi
if [[ -n $artifact ]]; then
    [[ $artifact == /* && -d $artifact && ! -L $artifact && -z $(ls -A -- "$artifact") ]] ||
        { printf 'bench: BENCH_ARTIFACT_DIR must name an empty directory by absolute path\n' >&2; exit 2; }
fi
# A diagnostic fixture of the hosted macOS controls: it plants a detached
# orphan or a cleanup fault, needs an artifact directory and never publishes.
fixture=''
if [[ $system == Darwin ]]; then
    fixture=${BENCH_FIXTURE-}
    case $fixture in
        ''|marked-orphan|unmarked-orphan|signal-failure|listing-zero|listing-without-self) ;;
        *) printf 'bench: unknown BENCH_FIXTURE: %s\n' "$fixture" >&2; exit 2 ;;
    esac
    if [[ -n $fixture && -z $artifact ]]; then printf 'bench: BENCH_FIXTURE needs BENCH_ARTIFACT_DIR\n' >&2; exit 2; fi
    # Which workflow job ran this bench, for the run record.
    case ${BENCH_JOB-} in
        node-baseline-darwin|node-baseline-darwin-interrupt) job_name="$BENCH_JOB job of .github/workflows/test.yaml on the hosted xcode-27 runner" ;;
        '') job_name='no workflow job named (BENCH_JOB unset)' ;;
        *) printf 'bench: unknown BENCH_JOB: %s\n' "$BENCH_JOB" >&2; exit 2 ;;
    esac
    if [[ -n $fixture ]]; then job_name+=", diagnostic fixture $fixture"; fi
fi

# Started through $supervisor.
# shellcheck disable=SC2329
supervise_job() {
    exec python3 -I - "$1" "$2" "$3" <<'PY'
import ctypes
import os
import signal
import sys
import time

job, root, work = sys.argv[1:]
interrupt_file = work + '/interrupted'
interrupted = False
supervisor_started = time.monotonic()


def report(message):
    try:
        print(f'+{time.monotonic() - supervisor_started:.3f}s {message}', file=sys.stderr, flush=True)
    except OSError:
        pass  # The private log is evidence, not a condition for containment.


def note_interrupt(_signum, _frame):
    global interrupted
    interrupted = True


def stopping():
    return interrupted or os.path.exists(interrupt_file)


def children():
    # This lists only our own direct children, including adopted orphans. It
    # nominates PIDs to signal, but can never certify that the tree is empty.
    with open('/proc/thread-self/children', encoding='ascii') as file:
        return [int(pid) for pid in file.read().split()]


def supervise():
    watched = (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)
    for sig in watched:
        signal.signal(sig, note_interrupt)
    signal.signal(signal.SIGCHLD, signal.SIG_DFL)
    libc = ctypes.CDLL(None, use_errno=True)
    pr_set_child_subreaper = 36
    if libc.prctl(pr_set_child_subreaper, 1, 0, 0, 0) == -1:
        errno = ctypes.get_errno()
        raise OSError(errno, os.strerror(errno), 'PR_SET_CHILD_SUBREAPER')
    children()  # Refuse before launch if the signal target interface is absent.

    job_deadline = time.monotonic() + 360
    job_pid = None if stopping() else os.fork()
    if job_pid == 0:
        try:
            for sig in watched:
                signal.signal(sig, signal.SIG_DFL)
            # A child still alive at the cleanup deadline must not hold the
            # SSH session open through an inherited output pipe.
            log = os.open(work + '/job.log', os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            os.dup2(log, 1)
            os.dup2(log, 2)
            os.close(log)
            os.environ['MODEL_GATEWAY_BENCH_RUN'] = work
            os.execvp('bash', ['bash', '-euo', 'pipefail', '-c', job + '\nrun_job "$@"', 'bench', root, work])
        except OSError as error:
            report(f'bench: cannot exec job: {error}')
        finally:
            os._exit(127)

    job_status = None
    signaled = {}

    def reap(deadline):
        nonlocal job_status
        while True:
            try:
                pid, status = os.waitpid(-1, os.WNOHANG)
            except ChildProcessError:
                return True  # ECHILD: there is no remaining child to own descendants.
            if pid == 0:
                return False
            signaled.pop(pid, None)
            if pid == job_pid:
                job_status = os.waitstatus_to_exitcode(status)
            if time.monotonic() >= deadline:
                return False

    rc = 1
    try:
        while not stopping() and time.monotonic() < job_deadline:
            if reap(job_deadline) or job_status is not None:
                break
            time.sleep(0.025)
        if stopping():
            report('bench: interrupted')
        elif job_status is None:
            report('bench: job exceeded outer deadline')
            rc = 124
        else:
            rc = job_status if job_status >= 0 else 128 - job_status
    except OSError as error:
        report(f'bench: waiting for job failed: {error}')

    cleanup_started = time.monotonic()
    deadline = cleanup_started + 6
    forced = False
    pending, error = [], None
    while True:
        try:
            if reap(deadline):
                report('bench: subreaper has no remaining children (waitpid: ECHILD)')
                if rc == 0 and forced:
                    report('bench: refusing evidence after forced child termination')
                    return 1
                return 1 if stopping() and rc == 0 else rc
            pending = children()
            # We alone reap these PIDs. An exit between listing and signaling
            # leaves a waitable zombie, so a PID cannot be reused here.
            sig = signal.SIGTERM if time.monotonic() < cleanup_started + 3 else signal.SIGKILL
            for pid in pending:
                if signaled.get(pid) == sig:
                    continue
                try:
                    os.kill(pid, sig)
                except ProcessLookupError:
                    continue
                except OSError as err:
                    error = f'{sig.name} PID {pid}: {err}'
                    continue
                signaled[pid] = sig
                forced = True
                report(f'bench: {sig.name} child PID {pid}')
        except OSError as err:
            error = str(err)
        if time.monotonic() >= deadline:
            leftover = pending or list(signaled) or ([job_pid] if job_status is None else [])
            report(f'bench: cleanup deadline without ECHILD; child PIDs (last known): {leftover}; last error: {error}')
            return 1
        time.sleep(0.025)


try:
    sys.exit(supervise())
except OSError as error:
    sys.exit(f'bench: cannot establish containment: {error}')
PY
}

# macOS has no caller-selected subreaper: an orphan is reparented to launchd,
# so waiting for a child proves only that this supervisor's own child is gone.
# Containment there is the hosted runner's teardown plus a sweep for the
# processes this run marked, grouped or still parents. One program serves the
# supervisor and the bounded runner that stands in for GNU timeout.
if [[ $system == Darwin ]]; then
    IFS= read -r -d '' darwin_program <<'PY' || :
import base64
import ctypes
import datetime
import errno
import gzip
import hashlib
import json
import os
import signal
import struct
import sys
import time

libc = ctypes.CDLL(None, use_errno=True)
libc.proc_listpids.argtypes = [ctypes.c_uint32, ctypes.c_uint32, ctypes.c_void_p, ctypes.c_int]
libc.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]
libc.sysctl.argtypes = [ctypes.POINTER(ctypes.c_int), ctypes.c_uint, ctypes.c_void_p,
                        ctypes.POINTER(ctypes.c_size_t), ctypes.c_void_p, ctypes.c_size_t]
PROC_PGRP_ONLY = 2
PROC_UID_ONLY = 4
PROC_PIDT_BSDINFOWITHUNIQID = 18
BSDINFO_SIZE = 192  # struct proc_bsdinfowithuniqid in <sys/proc_info.h>
KINFO_SIZE = 648  # struct kinfo_proc on 64-bit macOS
SZOMB = 5
CTL_KERN = 1
KERN_PROC = 14
KERN_PROC_PID = 1
KERN_PROCARGS2 = 49
WATCHED = (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)
started = time.monotonic()
me = os.getpid()


class Unresolved(OSError):
    """A listed process that is neither readable, a zombie nor gone."""


def report(message):
    try:
        print(f'+{time.monotonic() - started:.3f}s {message}', file=sys.stderr, flush=True)
    except OSError:
        pass  # The log is evidence, not a condition for containment.


def failure(what):
    err = ctypes.get_errno()
    return OSError(err, os.strerror(err), what)


def listed(kind, value):
    # proc_listpids returns 0, not -1, when the call fails. Every listing made
    # here includes a known process, so an empty answer is a failure too.
    def call(buffer, size):
        ctypes.set_errno(0)
        result = libc.proc_listpids(kind, value, buffer, size)
        if result <= 0:
            err = ctypes.get_errno() or errno.EIO
            raise OSError(err, os.strerror(err), f'proc_listpids type {kind}')
        return result

    capacity = call(None, 0) // 4 + 64
    while True:
        buffer = (ctypes.c_int * capacity)()
        size = call(buffer, ctypes.sizeof(buffer))
        if size < ctypes.sizeof(buffer):
            return [pid for pid in buffer[:size // 4] if pid > 0]
        capacity *= 2


def kernel_record(pid):
    # kern.proc.pid also describes a zombie, which proc_pidinfo does not.
    mib = (ctypes.c_int * 4)(CTL_KERN, KERN_PROC, KERN_PROC_PID, pid)
    buffer = ctypes.create_string_buffer(KINFO_SIZE)
    size = ctypes.c_size_t(KINFO_SIZE)
    if libc.sysctl(mib, 4, buffer, ctypes.byref(size), None, 0) != 0:
        raise failure(f'kern.proc.pid PID {pid}')
    if size.value == 0:
        return None
    seconds, microseconds = struct.unpack_from('<qi', buffer.raw, 0)
    if size.value != KINFO_SIZE or struct.unpack_from('<i', buffer.raw, 40)[0] != pid:
        raise OSError(errno.EIO, f'kern.proc.pid PID {pid}: unexpected record')
    return {'zombie': struct.unpack_from('<b', buffer.raw, 36)[0] == SZOMB, 'start': seconds * 1000000 + microseconds}


def process(pid):
    # None: no process. Otherwise the start time in microseconds identifies
    # the process; a zombie has exited and holds nothing but its status.
    info = ctypes.create_string_buffer(BSDINFO_SIZE)
    ctypes.set_errno(0)
    if libc.proc_pidinfo(pid, PROC_PIDT_BSDINFOWITHUNIQID, 0, info, BSDINFO_SIZE) == BSDINFO_SIZE:
        fields = struct.unpack_from('<12I', info.raw)
        if fields[3] != pid:
            raise Unresolved(errno.EIO, f'proc_pidinfo PID {pid} described PID {fields[3]}')
        seconds, microseconds = struct.unpack_from('<2Q', info.raw, 120)
        return {
            'zombie': False, 'ppid': fields[4], 'uid': fields[5],
            'pgid': struct.unpack_from('<I', info.raw, 100)[0],
            'start': seconds * 1000000 + microseconds,
            'comm': info.raw[48:64].split(b'\0', 1)[0].decode('ascii', 'replace'),
            'version': struct.unpack_from('<i', info.raw, 168)[0],
        }
    error = failure(f'proc_pidinfo PID {pid}')
    record = kernel_record(pid)
    if record is None or record['zombie']:
        return record
    # A permission error is not proof of another owner: a policy can refuse
    # inspection of a process of this user.
    raise Unresolved(error.errno, f'{error.strerror} ({error.filename})')


def environment(pid):
    # The 64-bit kern.procargs2 layout: argc, the executable path, NUL padding
    # to eight bytes counted from the stripped executable_path= prefix, argv,
    # then the initial environment.
    mib = (ctypes.c_int * 3)(CTL_KERN, KERN_PROCARGS2, pid)
    size = ctypes.c_size_t(0)
    if libc.sysctl(mib, 3, None, ctypes.byref(size), None, 0) != 0:
        raise failure(f'kern.procargs2 size PID {pid}')
    buffer = ctypes.create_string_buffer(size.value)
    if libc.sysctl(mib, 3, buffer, ctypes.byref(size), None, 0) != 0:
        raise failure(f'kern.procargs2 PID {pid}')
    raw = buffer.raw[:size.value]
    if len(raw) < 5:
        raise OSError(errno.EIO, f'kern.procargs2 PID {pid}: missing argc')
    argc = struct.unpack_from('<I', raw)[0]
    path, separator, rest = raw[4:].partition(b'\0')
    pad = -(len('executable_path=') + len(path) + 1) & 7
    if not separator or not path or argc < 1 or len(rest) <= pad or rest[:pad].strip(b'\0') or rest[pad] == 0:
        raise OSError(errno.EIO, f'kern.procargs2 PID {pid}: invalid layout')
    strings = rest[pad:].split(b'\0')
    if len(strings) <= argc:
        raise OSError(errno.EIO, f'kern.procargs2 PID {pid}: truncated argv')
    env = []
    for entry in strings[argc:]:
        if not entry:
            break
        env.append(entry)
    return env


libc.proc_signal_with_audittoken.argtypes = [ctypes.c_void_p, ctypes.c_int]


def signal_identity(pid, version, sig):
    # The kernel delivers only to the process whose PID and version both
    # match, so an exited PID that was reused cannot receive the signal.
    token = (ctypes.c_uint32 * 8)()
    token[5] = pid
    token[7] = version & 0xffffffff
    ctypes.set_errno(0)
    # libproc returns the error number itself; -1 would leave it in errno.
    result = libc.proc_signal_with_audittoken(ctypes.byref(token), sig)
    if result == -1:
        result = ctypes.get_errno() or errno.EIO
    if result == 0:
        return True
    if result == errno.ESRCH:
        return False
    raise OSError(result, os.strerror(result), f'{sig.name} PID {pid}')


def check_identity_signals():
    # The call must refuse a wrong version and deliver exactly one signal for
    # the right one; otherwise it does not bind a signal to one process and
    # the sweep must not signal at all.
    received = []
    previous = signal.signal(signal.SIGWINCH, lambda _signum, _frame: received.append(True))
    try:
        mine = process(me)
        if signal_identity(me, mine['version'] + 1, signal.SIGWINCH):
            raise OSError(errno.EIO, 'proc_signal_with_audittoken delivered to a mismatched version')
        if not signal_identity(me, mine['version'], signal.SIGWINCH):
            raise OSError(errno.EIO, 'proc_signal_with_audittoken refused this process with its own version')
        deadline = time.monotonic() + 2
        while not received and time.monotonic() < deadline:
            time.sleep(0.01)
        time.sleep(0.05)
        if len(received) != 1:
            raise OSError(errno.EIO, f'the identity probe received {len(received)} signals, expected exactly one')
    finally:
        signal.signal(signal.SIGWINCH, previous)


def bounded(seconds, argv):
    # Like GNU timeout --kill-after=1s, for a whole process group: TERM at the
    # deadline, KILL a second later, then wait until no live member remains.
    # The unreaped leader keeps the group number from being reused.
    child = os.fork()
    if child == 0:
        try:
            os.setpgid(0, 0)
            for sig in WATCHED:
                signal.signal(sig, signal.SIG_DFL)
            os.execvp(argv[0], argv)
        except OSError as error:
            report(f'bounded: cannot exec {argv[0]}: {error}')
        finally:
            os._exit(127)
    try:
        os.setpgid(child, child)
    except OSError:
        pass  # The child already did it, or has exec'd after doing it.

    failures = []

    def signal_group(sig):
        # No live member left is not an error; anything else is reported and
        # fails the run.
        try:
            os.killpg(child, sig)
        except ProcessLookupError:
            pass
        except OSError as error:
            failures.append(f'{signal.Signals(sig).name} to process group {child}: {error}')
            report(f'bounded: {failures[-1]}')

    def forward(signum, _frame):
        signal_group(signum)

    for sig in WATCHED:
        signal.signal(sig, forward)
    phase, deadline = 'run', time.monotonic() + seconds
    while True:
        try:
            leader = kernel_record(child)
            members = []
            group = listed(PROC_PGRP_ONLY, child)
            if child not in group:
                raise OSError(errno.EIO, 'the group listing does not include its unreaped leader')
            for pid in group:
                try:
                    record = process(pid)
                except OSError:
                    record = {'zombie': False}  # Unknown counts as live.
                if record is not None and not record['zombie']:
                    members.append(pid)
            if leader is not None and leader['zombie'] and not members:
                break
        except OSError as error:
            report(f'bounded: cannot inspect process group {child}: {error}')
        now = time.monotonic()
        if now >= deadline:
            if phase == 'kill':
                report(f'bounded: process group {child} still has members 5 s after KILL')
                try:
                    os.waitpid(child, os.WNOHANG)  # Never wait past the hard deadline.
                except ChildProcessError:
                    pass
                return 125
            phase, deadline = ('term', now + 1) if phase == 'run' else ('kill', now + 5)
            signal_group(signal.SIGTERM if phase == 'term' else signal.SIGKILL)
        time.sleep(0.02)
    _, status = os.waitpid(child, 0)
    if failures:
        return 125
    if phase != 'run':
        return 124
    code = os.waitstatus_to_exitcode(status)
    return code if code >= 0 else 128 - code


# A detached process for a diagnostic run. It ends when the release file
# appears (created by its owner, or by the supervisor at an injected fault),
# so no one has to signal it by number; it gives up after 900 s.
FIXTURE_SCRIPT = r'''
my ($tag, $dir) = @ARGV;
my $deadline = time + 900;
select undef, undef, undef, 0.1 while time < $deadline && !-e "$dir/fixture-release";
'''
ORPHAN_FIXTURES = ('marked-orphan', 'unmarked-orphan', 'signal-failure')
FAULT_FIXTURES = ('listing-zero', 'listing-without-self')


def start_fixture(kind, directory):
    # The intermediate exits at once, so launchd adopts the orphan. Its PID
    # and start time go to fixture.pid for an independent observer.
    middle = os.fork()
    if middle == 0:
        try:
            orphan = os.fork()
            if orphan == 0:
                try:
                    os.setsid()
                    null = os.open('/dev/null', os.O_RDONLY)
                    os.dup2(null, 0)
                    os.close(null)
                    # A minimal environment: nothing inherited but the marker.
                    env = {'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'}
                    if kind != 'unmarked-orphan':
                        env['MODEL_GATEWAY_BENCH_RUN'] = os.environ['MODEL_GATEWAY_BENCH_RUN']
                    os.execve('/usr/bin/perl', ['perl', '-e', FIXTURE_SCRIPT, f'bench-fixture-{kind}', directory], env)
                finally:
                    os._exit(127)
            record = process(orphan)
            with open(directory + '/fixture.pid', 'x') as file:
                file.write(f'{orphan} {record["start"] if record else 0}\n')
        finally:
            os._exit(0)
    os.waitpid(middle, 0)


def inject_listing_fault(kind):
    # Replaces the libc call itself, so the real checks of listed() and
    # table() meet the fault: a listing of this user's processes that returns
    # nothing, or one that leaves the supervisor out.
    real = libc.proc_listpids

    def faulty(list_kind, value, buffer, size):
        if list_kind != PROC_UID_ONLY:
            return real(list_kind, value, buffer, size)
        if kind == 'listing-zero':
            ctypes.set_errno(0)
            return 0
        result = real(list_kind, value, buffer, size)
        if buffer is None or result <= 0:
            return result
        kept = [pid for pid in buffer[:result // 4] if pid != me]
        for index, pid in enumerate(kept):
            buffer[index] = pid
        return len(kept) * 4

    libc.proc_listpids = faulty


def supervise(job, root, work, fixture=''):
    interrupt_file = work + '/interrupted'
    marker = b'MODEL_GATEWAY_BENCH_RUN=' + os.fsencode(work)
    containment = ('containment by runner teardown and marker sweep; '
                   'absence of unmarked detached descendants not proven')
    uid = os.getuid()
    interrupted = False
    empty_scans, scan_interval_ms = 3, 100

    def note_interrupt(_signum, _frame):
        nonlocal interrupted
        interrupted = True

    def stopping():
        return interrupted or os.path.exists(interrupt_file)

    def table():
        # Every process of this user, read directly; a listed process that
        # cannot be resolved is reported, never skipped.
        processes, unknown = {}, []
        pids = listed(PROC_UID_ONLY, uid)
        if me not in pids:
            raise OSError(errno.EIO, 'the listing of this user\'s processes does not include the supervisor')
        for pid in pids:
            if pid == me:
                continue
            try:
                record = process(pid)
            except Unresolved as error:
                unknown.append(f'PID {pid}: {error}')
                continue
            if record is not None:
                processes[pid] = record
        return processes, unknown

    def scan(previous, observed, job_pid):
        # The processes of the run that are alive now: new and marked, in the
        # job's group, below this supervisor, or observed earlier and alive.
        processes, unknown = table()
        found = {}
        for pid, record in processes.items():
            identity = (pid, record['start'])
            if record['zombie'] or identity in previous:
                continue
            reason = observed.get(identity)
            if reason is None and record['pgid'] == job_pid:
                reason = 'grouped'
            ancestor, seen = record['ppid'], set()
            while reason is None and ancestor not in seen:
                if ancestor == me:
                    reason = 'descendant'
                    break
                if ancestor not in processes or processes[ancestor]['zombie']:
                    break  # An exited parent has no parent of its own on record.
                seen.add(ancestor)
                ancestor = processes[ancestor]['ppid']
            if reason is None:
                try:
                    if marker not in environment(pid):
                        continue
                    reason = 'marked'
                except OSError as error:
                    try:
                        again = process(pid)
                    except OSError:
                        again = record
                    if again is None or again['zombie'] or again['start'] != record['start']:
                        continue
                    unknown.append(f'PID {pid} ({record["comm"]}): {error}')
                    continue
            found[identity] = (reason, record['comm'], record['version'])
        return found, unknown

    def harness_frame():
        # The frame the harness writes only after a complete, successful run.
        with open(work + '/result', 'rb') as file:
            parts = file.read().rstrip(b'\n').split(b' ')
        if len(parts) != 3 or parts[0] != b'NODE-BENCH-V1':
            raise ValueError('no evidence frame from the harness')
        payload = base64.b64decode(parts[2], validate=True)
        if hashlib.sha256(payload).hexdigest().encode() != parts[1]:
            raise ValueError('damaged evidence frame from the harness')
        return payload

    def publish_cleanup(observations):
        # The harness wrote its frame before this sweep; the published frame
        # carries what the sweep observed as its last record.
        path = work + '/result'
        payload = harness_frame()
        record = {
            'type': 'cleanup',
            'checked': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.%fZ'),
            'containment': containment,
            'observations': observations,
        }
        raw = gzip.decompress(payload) + (json.dumps(record, ensure_ascii=False, separators=(',', ':')) + '\n').encode()
        payload = gzip.compress(raw, mtime=0)
        with open(path + '.new', 'xb') as file:
            file.write(b'NODE-BENCH-V1 ' + hashlib.sha256(payload).hexdigest().encode() + b' ' +
                       base64.b64encode(payload) + b'\n')
        os.replace(path + '.new', path)

    for sig in WATCHED:
        signal.signal(sig, note_interrupt)
    signal.signal(signal.SIGCHLD, signal.SIG_DFL)
    # Refuse before launch if any part of the sweep cannot work here.
    environment(me)
    check_identity_signals()
    # A process caught while it starts or exits can be unreadable once; only
    # one that stays unreadable on a second look refuses the run.
    processes, unknown = table()
    if unknown:
        time.sleep(0.2)
        processes, unknown = table()
        if not unknown:
            report('bench: a second listing had no unresolved entries')
    if unknown:
        raise OSError(errno.EPERM, 'processes of this user that cannot be inspected: ' + '; '.join(unknown))
    # Processes older than the run cannot carry its marker. The start time
    # keeps a reused PID from exempting a process of the run.
    previous = {(pid, record['start']) for pid, record in processes.items()}

    # The hosted runner is slower than the Linux venue; the budget is larger.
    job_deadline = time.monotonic() + 600
    job_pid = None if stopping() else os.fork()
    if job_pid == 0:
        try:
            for sig in WATCHED:
                signal.signal(sig, signal.SIG_DFL)
            # A process group of its own lets the sweep find children that
            # neither detached nor kept the marker. The job stays unreaped
            # until the sweep ends, so its PID and group number stay reserved.
            os.setsid()
            log = os.open(work + '/attempt/job.log', os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            os.dup2(log, 1)
            os.dup2(log, 2)
            os.close(log)
            os.environ['MODEL_GATEWAY_BENCH_RUN'] = work
            if fixture in ORPHAN_FIXTURES:
                start_fixture(fixture, os.path.realpath(work + '/attempt'))
            os.execvp('bash', ['bash', '-euo', 'pipefail', '-c', job + '\nrun_job "$@"', 'bench', root, work])
        except OSError as error:
            report(f'bench: cannot exec job: {error}')
        finally:
            os._exit(127)

    def job_exited():
        record = kernel_record(job_pid)
        return record is None or record['zombie']

    timed_out = False
    try:
        while job_pid is not None and not stopping() and not job_exited():
            if time.monotonic() >= job_deadline:
                timed_out = True
                break
            time.sleep(0.025)
    except OSError as error:
        report(f'bench: waiting for job failed: {error}')
    if stopping():
        report('bench: interrupted')
    elif timed_out:
        report('bench: job exceeded outer deadline')

    send = signal_identity
    if fixture:
        report(f'bench: diagnostic fixture {fixture}: this run publishes no evidence')
        # A fault is armed only after the harness frame validated, which the
        # harness writes only after a complete run. That is all this claims.
        try:
            harness_frame()
            report(f'bench: fixture {fixture}: the harness frame validated; arming the fixture')
            armed = True
        except (OSError, ValueError) as err:
            report(f'bench: fixture {fixture}: not armed, the harness frame did not validate: {err}')
            armed = False
        attempt_dir = os.path.realpath(work + '/attempt')
        if armed and fixture in FAULT_FIXTURES:
            inject_listing_fault(fixture)
        if armed and fixture == 'signal-failure':
            with open(attempt_dir + '/fixture.pid') as file:
                target = tuple(int(field) for field in file.read().split())
            injected = []

            def send(pid, version, sig):
                # Exactly one failure, for the recorded target; its witness
                # then releases the target, which exits by itself.
                record = kernel_record(pid)
                if not injected and record is not None and (pid, record['start']) == target:
                    injected.append(True)
                    with open(attempt_dir + '/fault-injected', 'x') as file:
                        file.write(f'{pid} {target[1]} {sig.name}\n')
                    with open(attempt_dir + '/fixture-release', 'x'):
                        pass
                    report(f'bench: fixture signal-failure: injected a failed {sig.name} for PID {pid}')
                    raise OSError(errno.EPERM, 'injected signal failure', f'{sig.name} PID {pid}')
                return signal_identity(pid, version, sig)

    cleanup_started = time.monotonic()
    deadline = cleanup_started + 10
    observed, signaled = {}, {}
    pending, error, empty = {}, None, 0
    reported_error = None

    def report_error(message):
        # Every distinct inspection failure is logged when it happens, not
        # only the last one before a deadline.
        nonlocal reported_error
        if message != reported_error:
            reported_error = message
            report(f'bench: sweep inspection failed: {message}')
    # A signal that failed for any reason but an exited target stays recorded,
    # even if the process exits later: such a run publishes no evidence. Its
    # target is not signalled again; the sweep waits for it or its deadline.
    signal_failures, failed = [], set()
    while True:
        try:
            pending, unknown = scan(previous, observed, job_pid)
            for identity, (reason, _, _) in pending.items():
                observed.setdefault(identity, reason)
            if unknown:
                error = '; '.join(unknown)
                report_error(error)
            if not pending and not unknown and (job_pid is None or job_exited()):
                empty += 1
                if empty >= empty_scans:
                    break
                time.sleep(scan_interval_ms / 1000)
                continue
            empty = 0
            sig = signal.SIGTERM if time.monotonic() < cleanup_started + 3 else signal.SIGKILL
            for identity, (reason, comm, version) in pending.items():
                if signaled.get(identity) == sig or identity in failed:
                    continue
                try:
                    delivered = send(identity[0], version, sig)
                except OSError as err:
                    error = str(err)
                    signal_failures.append(error)
                    failed.add(identity)
                    report(f'bench: signal failed: {error}')
                    continue
                if delivered:
                    signaled[identity] = sig
                    report(f'bench: {sig.name} {reason} PID {identity[0]} ({comm})')
        except OSError as err:
            error = str(err)
            report_error(error)
            empty = 0
        if time.monotonic() >= deadline:
            leftover = sorted(pid for pid, _ in pending) or sorted(pid for pid, _ in observed)
            report(f'bench: cleanup deadline with processes of the run (last observed): {leftover}; last error: {error}')
            return 1
        time.sleep(0.025)

    rc = 1
    if job_pid is not None:
        _, status = os.waitpid(job_pid, 0)
        code = os.waitstatus_to_exitcode(status)
        rc = 124 if timed_out else (code if code >= 0 else 128 - code)
    try:
        os.waitpid(-1, os.WNOHANG)
        report('bench: the supervisor still has a child after the sweep')
        return 1
    except ChildProcessError:
        pass  # ECHILD: the job was this supervisor's only child.
    report(f'bench: {empty_scans} consecutive scans observed no process of the run '
           f'(marked, grouped or descendant); {len(observed)} observed during cleanup, '
           f'{len(signaled)} signaled; {containment}')
    if signal_failures:
        report(f'bench: refusing evidence after {len(signal_failures)} failed signal(s)')
        return 1
    if signaled and rc == 0:
        report('bench: refusing evidence after forced termination')
        return 1
    if stopping():
        return 1
    if fixture:
        report('bench: fixture run: evidence withheld')
        return 1
    if rc == 0:
        try:
            publish_cleanup({
                'sweep': 'marked, grouped and descendant processes of the job: none observed',
                'note': ('after the job ended, consecutive scans of the processes of this user observed no '
                         'process that started during the run and carried the run marker, kept the job process '
                         'group or descended from the supervisor; every process of the run observed during '
                         'cleanup was seen to exit'),
                'consecutiveEmptyScans': empty_scans,
                'scanIntervalMs': scan_interval_ms,
                'observedDuringCleanup': len(observed),
                'signaled': len(signaled),
                'preRunProcesses': len(previous),
            })
        except (OSError, ValueError) as err:
            report(f'bench: cannot record the sweep in the evidence frame: {err}')
            return 1
    return rc



  const state = spawnSync('/bin/ps', ['-o', 'stat=', '-p', String(pid)], { encoding: 'utf8', timeout: 10000, env: launchEnv });
  assert.equal(state.error, undefined, `ps stat for PID ${pid}: ${state.error}`);
  assert.equal(state.stderr, '', `ps stat for PID ${pid} wrote to stderr`);
  if (state.status === 1 && state.stdout === '') {

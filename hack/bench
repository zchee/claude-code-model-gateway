set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
"$root/hack/venue-check"
# This run reads Linux RSS and relies on the kernel's ephemeral port range.
[[ $(uname -s) == Linux ]] || { printf 'not a test venue: bench requires Linux\n' >&2; exit 97; }
read -r low high < /proc/sys/net/ipv4/ip_local_port_range
for port in 80 18764 18765; do
    (( port < low || port > high )) || { printf 'bench: ephemeral range includes forbidden port %s\n' "$port" >&2; exit 1; }
done
if command -v claude >/dev/null; then printf 'bench: claude resolves on venue PATH\n' >&2; exit 1; fi

supervise_job() {
    exec python3 -I - "$1" "$2" "$3" <<'PY'
import ctypes
import os
import signal
import sys
import time

job, root, work = sys.argv[1:]
interrupt_file = work + '/interrupted'
interrupted = False
supervisor_started = time.monotonic()


def report(message):
    try:
        print(f'+{time.monotonic() - supervisor_started:.3f}s {message}', file=sys.stderr, flush=True)
    except OSError:
        pass  # The private log is evidence, not a condition for containment.


def note_interrupt(_signum, _frame):
    global interrupted
    interrupted = True


def stopping():
    return interrupted or os.path.exists(interrupt_file)


def children():
    # This lists only our own direct children, including adopted orphans. It
    # nominates PIDs to signal, but can never certify that the tree is empty.
    with open('/proc/thread-self/children', encoding='ascii') as file:
        return [int(pid) for pid in file.read().split()]


def supervise():
    watched = (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)
    for sig in watched:
        signal.signal(sig, note_interrupt)
    signal.signal(signal.SIGCHLD, signal.SIG_DFL)
    libc = ctypes.CDLL(None, use_errno=True)
    pr_set_child_subreaper = 36
    if libc.prctl(pr_set_child_subreaper, 1, 0, 0, 0) == -1:
        errno = ctypes.get_errno()
        raise OSError(errno, os.strerror(errno), 'PR_SET_CHILD_SUBREAPER')
    children()  # Refuse before launch if the signal target interface is absent.

    job_deadline = time.monotonic() + 360
    job_pid = None if stopping() else os.fork()
    if job_pid == 0:
        try:
            for sig in watched:
                signal.signal(sig, signal.SIG_DFL)
            # A child still alive at the cleanup deadline must not hold the
            # SSH session open through an inherited output pipe.
            log = os.open(work + '/job.log', os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            os.dup2(log, 1)
            os.dup2(log, 2)
            os.close(log)
            os.environ['MODEL_GATEWAY_BENCH_RUN'] = work
            os.execvp('bash', ['bash', '-euo', 'pipefail', '-c', job + '\nrun_job "$@"', 'bench', root, work])
        except OSError as error:
            report(f'bench: cannot exec job: {error}')
        finally:
            os._exit(127)

    job_status = None
    signaled = {}

    def reap(deadline):
        nonlocal job_status
        while True:
            try:
                pid, status = os.waitpid(-1, os.WNOHANG)
            except ChildProcessError:
                return True  # ECHILD: there is no remaining child to own descendants.
            if pid == 0:
                return False
            signaled.pop(pid, None)
            if pid == job_pid:
                job_status = os.waitstatus_to_exitcode(status)
            if time.monotonic() >= deadline:
                return False

    rc = 1
    try:
        while not stopping() and time.monotonic() < job_deadline:
            if reap(job_deadline) or job_status is not None:
                break
            time.sleep(0.025)
        if stopping():
            report('bench: interrupted')
        elif job_status is None:
            report('bench: job exceeded outer deadline')
            rc = 124
        else:
            rc = job_status if job_status >= 0 else 128 - job_status
    except OSError as error:
        report(f'bench: waiting for job failed: {error}')

    cleanup_started = time.monotonic()
    deadline = cleanup_started + 6
    forced = False
    pending, error = [], None
    while True:
        try:
            if reap(deadline):
                report('bench: subreaper has no remaining children (waitpid: ECHILD)')
                if rc == 0 and forced:
                    report('bench: refusing evidence after forced child termination')
                    return 1
                return 1 if stopping() and rc == 0 else rc
            pending = children()
            # We alone reap these PIDs. An exit between listing and signaling
            # leaves a waitable zombie, so a PID cannot be reused here.
            sig = signal.SIGTERM if time.monotonic() < cleanup_started + 3 else signal.SIGKILL
            for pid in pending:
                if signaled.get(pid) == sig:
                    continue
                try:
                    os.kill(pid, sig)
                except ProcessLookupError:
                    continue
                except OSError as err:
                    error = f'{sig.name} PID {pid}: {err}'
                    continue
                signaled[pid] = sig
                forced = True
                report(f'bench: {sig.name} child PID {pid}')
        except OSError as err:
            error = str(err)
        if time.monotonic() >= deadline:
            leftover = pending or list(signaled) or ([job_pid] if job_status is None else [])
            report(f'bench: cleanup deadline without ECHILD; child PIDs (last known): {leftover}; last error: {error}')
            return 1
        time.sleep(0.025)


try:
    sys.exit(supervise())
except OSError as error:
    sys.exit(f'bench: cannot establish containment: {error}')
PY
}

# Called by the timed child shell, not by this wrapper.
# shellcheck disable=SC2329
run_job() {
    local root=$1 work=$2 plugin
    local -a clean=(env -i "PATH=$PATH" "HOME=$work/home" "TMPDIR=$work/tmp" LC_ALL=C "MODEL_GATEWAY_BENCH_RUN=$work")
    mkdir "$work/hack" "$work/home" "$work/tmp" "$work/bin"
    cp -- "$root/hack/pinned-source" "$work/hack/"
    # The source exporter clears its environment for Git. Restore only our
    # marker across that boundary with an env shim private to the export.
    # shellcheck disable=SC2016
    printf '%s\n' '#!/bin/bash' 'if [[ ${1:-} == -i ]]; then' '    shift' \
        '    set -- -i "MODEL_GATEWAY_BENCH_RUN=$MODEL_GATEWAY_BENCH_RUN" "$@"' 'fi' \
        'exec /usr/bin/env "$@"' > "$work/bin/env"
    chmod +x "$work/bin/env"
    plugin=$("${clean[@]}" "PATH=$work/bin:$PATH" "$work/hack/pinned-source")/plugins/model-gateway
    "${clean[@]}" "$work/hack/pinned-source" --print-pin > "$work/pin"
    "${clean[@]}" "npm_config_cache=$work/npm-cache" \
        npm --prefix "$plugin" ci --ignore-scripts --no-audit --no-fund >&2

    exec "${clean[@]}" node --input-type=commonjs - "$plugin" "$work" > "$work/result" <<'JS'
'use strict';
const assert = require('node:assert/strict');
const { execFileSync, spawn } = require('node:child_process');
const { createHash } = require('node:crypto');
const { once } = require('node:events');
const fs = require('node:fs');
const http = require('node:http');
const net = require('node:net');
const os = require('node:os');
const path = require('node:path');
const { setTimeout: sleep } = require('node:timers/promises');
const { gzipSync } = require('node:zlib');

const [plugin, work] = process.argv.slice(2);
const cli = path.join(plugin, 'bin/model-gateway.js');
const { writeCommandLauncher } = require(path.join(plugin, 'hooks/registry-writer.js'));
const pluginVersion = require(path.join(plugin, '.claude-plugin/plugin.json')).version;
const [commit, rootTree, pluginTree] = fs.readFileSync(path.join(work, 'pin'), 'utf8').trim().split('\t');
const node = process.execPath;
const loopback = '127.0.0.1';
const commands = {
  run: 'VENUE_HOST=debian-13-trixie.gaudiy-platform ./hack/remote run bench',
  status: 'VENUE_HOST=debian-13-trixie.gaudiy-platform ./hack/remote status',
  make: 'make -- bench → ./hack/venue-check && ./hack/bench',
  pin: '$WORK/hack/pinned-source',
  install: 'npm --prefix "$PLUGIN" ci --ignore-scripts --no-audit --no-fund',
  harness: 'node --input-type=commonjs - "$PLUGIN" "$WORK"',
  worker: 'node "$PLUGIN/bin/model-gateway.js" serve-worker',
  supervisor: 'node "$PLUGIN/bin/model-gateway.js" serve-shim',
  readiness: 'node "$HOME/.claude/model-gateway/model-gateway.js" readiness-gate',
  date: 'date -u +%Y-%m-%dT%H:%M:%S.%NZ',
  kernel: 'uname -srvm',
  CPU: 'lscpu -p=SOCKET,CORE',
  listeners: 'ss -H -ltn "sport = :$PORT"',
};
const settings = {
  series: 3, warmups: 1, readinessRuns: 50, ttfbRuns: 200,
  requestBytes: 1024 * 1024, events: 2000, idleMs: 60000,
  timeoutMs: 15000, headersSettleMs: 100, observationMs: 1500,
  pressureBytes: 16 * 1024 * 1024, pressureBlockBytes: 64 * 1024,
};
const run = { commit, rootTree, pluginTree, pluginVersion, commands, settings };
const command = (name, ...args) => execFileSync(name, args, { encoding: 'utf8' }).trim();
const date = () => command('date', '-u', '+%Y-%m-%dT%H:%M:%S.%NZ');
const load = () => ({ at: date(), averages: os.loadavg() });
const elapsed = (since) => Number((performance.now() - since).toFixed(6));
const envForReport = (env) => Object.fromEntries(Object.entries(env).map(([key, value]) => [key, value.replaceAll(work, '$WORK')]));
const record = (type, data) => ({ type, ...data });
const records = [];
const portURL = (port) => `http://${loopback}:${port}`;

const models = { anthropic: 'claude-sonnet-4-6', codex: 'claude-gpt-5.6-sol' };
const frame = (type, data) => `event: ${type}\ndata: ${JSON.stringify({ type, ...data })}\n\n`;
const start = frame('message_start', { message: { id: 'msg_fixture', type: 'message', role: 'assistant', model: models.anthropic, content: [], stop_reason: null, stop_sequence: null, usage: { input_tokens: 1, output_tokens: 0 } } });
const delta = frame('content_block_delta', { index: 0, delta: { type: 'text_delta', text: 'fixture reply ' } });
const response = start + frame('content_block_start', { index: 0, content_block: { type: 'text', text: '' } }) +
  delta.repeat(settings.events - 5) + frame('content_block_stop', { index: 0 }) +
  frame('message_delta', { delta: { stop_reason: 'end_turn', stop_sequence: null }, usage: { output_tokens: settings.events - 5 } }) +
  frame('message_stop', {});
assert.equal(response.match(/^event: /gm).length, settings.events);
const responseBytes = Buffer.byteLength(response);
function payload(model, padding = '') {
  return JSON.stringify({ model, max_tokens: 4096, stream: true, messages: [{ role: 'user', content: `fixture prompt ${padding}` }] });
}
const bigBody = payload(models.anthropic, 'x'.repeat(settings.requestBytes - Buffer.byteLength(payload(models.anthropic))));
assert.equal(Buffer.byteLength(bigBody), settings.requestBytes);

const checkPort = (port) => assert(port > 0 && ![80, 18764, 18765].includes(port), `unexpected port ${port}`);
async function fakeUpstream(provider, cleanup) {
  const probes = new Map();
  const sockets = new Set();
  let port, usagePosts = 0;
  const server = http.createServer((req, res) => {
    if (provider === 'usage') {
      req.resume();
      req.once('end', () => {
        if (req.method !== 'POST' || req.url !== '/v1/logs') return res.writeHead(400).end();
        usagePosts++;
        res.setHeader('Content-Type', 'application/json');
        res.end('{}');
      });
      return;
    }
    if (req.method === 'GET' && req.url.split('?')[0] === '/v1/models') {
      res.setHeader('Content-Type', 'application/json');
      res.end(JSON.stringify({ data: [{ id: provider === 'codex' ? 'gpt-5.6-sol' : models.anthropic }] }));
      return;
    }
    const probe = probes.get(req.headers['x-bench-probe']);
    let bytes = 0;
    req.on('data', (chunk) => { bytes += chunk.length; if (probe) probe.providerRequestBytes += chunk.length; });
    if (probe) {
      probe.requests++;
      probe.note('provider-request', { method: req.method, path: req.url });
      probe.upstream = res;
      probe.socket = req.socket;
      req.socket.once('close', () => probe.note('provider-socket-close'));
      res.once('close', () => probe.note('provider-response-close', { finished: res.writableFinished }));
      res.once('finish', () => probe.note('provider-response-finish'));
    }
    req.once('end', () => {
      if (!probe && (req.method !== 'POST' || req.url !== '/v1/messages' || bytes !== settings.requestBytes || provider !== 'anthropic')) {
        res.writeHead(400).end('unexpected benchmark input');
        return;
      }
      if (!probe) return res.writeHead(200, { 'Content-Type': 'text/event-stream' }).end(response);
      probe.note('provider-upload-end', { bytes });
      probe.releaseHeaders = () => {
        if (res.destroyed) { probe.note('provider-headers-skipped'); return; }
        res.writeHead(200, { 'Content-Type': 'text/event-stream' });
        res.flushHeaders();
        probe.note('provider-headers');
      };
      if (probe.stage !== 'awaiting-headers') probe.releaseHeaders();
      if (probe.stage === 'mid-stream') {
        res.write(start);
        probe.providerResponseBytes += Buffer.byteLength(start);
        probe.note('provider-first-event');
      }
      probe.signalUpload();
    });
  });
  server.on('connection', (socket) => {
    sockets.add(socket);
    socket.once('close', () => sockets.delete(socket));
  });
  cleanup.push(async () => {
    for (const socket of sockets) socket.destroy();
    if (server.listening) {
      await bounded(new Promise((resolve, reject) => server.close((err) => err ? reject(err) : resolve())), `close ${provider}`);
    }
    if (port !== undefined) checkClosed(port);
  });
  await bounded(new Promise((resolve, reject) => server.once('error', reject).listen(0, loopback, resolve)), `listen ${provider}`);
  port = server.address().port;
  checkPort(port);
  return { port, probes, usagePosts: () => usagePosts };
}

function request(port, url, body) {
  const began = performance.now();
  return new Promise((resolve, reject) => {
    let ttfbMs;
    const options = { host: loopback, port, path: url, agent: false };
    if (body) Object.assign(options, {
      method: 'POST', headers: { 'content-type': 'application/json', 'content-length': Buffer.byteLength(body) },
    });
    const req = http.request(options, (res) => {
      const chunks = [];
      res.on('data', (chunk) => chunks.push(chunk));
      res.on('error', reject);
      res.once('end', () => resolve({ status: res.statusCode, ttfbMs, body: Buffer.concat(chunks).toString() }));
    });
    req.on('error', reject);
    req.once('socket', (socket) => socket.once('data', () => { ttfbMs = elapsed(began); }));
    req.setTimeout(settings.timeoutMs, () => req.destroy(new Error(`request timed out: ${url}`)));
    req.end(body);
  });
}

function gateway(commandName, home, upstreams) {
  fs.mkdirSync(home);
  const env = {
    ...process.env, HOME: home,
    CODEX_GATEWAY_PORT: '0', CODEX_GATEWAY_WORKER_PORT: '0', CODEX_GATEWAY_COMPAT_PORT: '0',
    CODEX_GATEWAY_PROXY_PORT: String(upstreams.codex.port),
    CODEX_GATEWAY_ANTHROPIC_UPSTREAM: portURL(upstreams.anthropic.port),
    CODEX_GATEWAY_USAGE_ENDPOINT: `${portURL(upstreams.usage.port)}/v1/logs`,
    CODEX_GATEWAY_HOSTS_FILE: path.join(home, 'fixture-hosts'),
    CODEX_GATEWAY_SOCKET_PATH: path.join(home, 'gateway.sock'),
    CODEX_GATEWAY_CLAUDE_BIN: path.join(home, 'missing-claude'),
  };
  fs.writeFileSync(env.CODEX_GATEWAY_HOSTS_FILE, '');
  const child = spawn(node, [cli, commandName], { cwd: home, env, stdio: ['ignore', 'pipe', 'pipe', 'ipc'] });
  let stdout = '', stderr = '';
  child.stdout.on('data', (chunk) => { stdout += chunk; });
  child.stderr.on('data', (chunk) => { stderr += chunk; });
  // In the direct case we close IPC ourselves. Reap on 'exit' whether or not
  // Node's combined stdio/IPC 'close' event follows that disconnect.
  const status = once(child, 'exit');
  // A spawn error can arrive before the readiness poll enters its stop path.
  void status.catch(() => {});
  const state = path.join(home, '.claude/model-gateway');
  const topology = { child, env, home, state, port: null, workerPid: null, workerPort: null };
  const diagnostic = () => `${commandName}: ${stdout}${stderr}`;
  topology.ready = async () => {
    const began = performance.now();
    while (elapsed(began) < settings.timeoutMs && child.exitCode === null && child.signalCode === null) {
      const report = stdout.match(/listening on 127\.0\.0\.1:(\d+)/);
      if (report) {
        topology.port = Number(report[1]);
        checkPort(topology.port);
        const result = await request(topology.port, '/healthz');
        if (result.status === 200) {
          const health = JSON.parse(result.body);
          assert.equal(health.ok, true);
          if (commandName === 'serve-shim') {
            assert.equal(health.supervisorPid, child.pid);
            assert.equal(health.supervisorVersion, pluginVersion);
            assert.equal(health.proxyRecovery, true);
            const pidFile = path.join(state, 'shim.pid');
            const logFile = path.join(state, 'logs/shim.log');
            if (!fs.existsSync(pidFile) || !fs.existsSync(logFile)) { await sleep(25); continue; }
            topology.workerPid = Number(fs.readFileSync(pidFile, 'utf8').trim());
            const log = fs.readFileSync(logFile, 'utf8');
            topology.workerPort = Number(log.match(/listening on 127\.0\.0\.1:(\d+)/)?.[1]);
            checkPort(topology.workerPort);
            assert.equal(parentPID(topology.workerPid), child.pid);
          }
          return;
        }
      }
      await sleep(25);
    }
    throw new Error(`listener not ready: ${diagnostic()}`);
  };
  topology.stop = async () => {
    if (child.exitCode === null && child.signalCode === null && child.connected) {
      if (commandName === 'serve-shim') child.send({ type: 'fixture-shutdown' }, (err) => { if (err) child.kill('SIGTERM'); });
      else child.disconnect();
    }
    let outcome;
    try { outcome = await reapChild(child, status, `stop ${commandName}`); }
    finally {
      child.stdout.destroy();
      child.stderr.destroy();
      if (child.connected) child.disconnect();
    }
    const [code, signal] = outcome;
    assert.equal(code, 0, `${diagnostic()} (signal ${signal})`);
    for (const pid of [child.pid, topology.workerPid].filter(Boolean)) assert(!fs.existsSync(`/proc/${pid}`), `PID ${pid} remains`);
    for (const port of new Set([topology.port, topology.workerPort].filter(Boolean))) checkClosed(port);
  };
  return topology;
}

async function reapChild(child, status, what) {
  try { return await bounded(status, what); }
  catch (error) {
    for (const signal of ['SIGTERM', 'SIGKILL']) {
      if (child.exitCode === null && child.signalCode === null && child.pid) {
        console.error(`bench: ${signal} PID ${child.pid} after ${what} failed`);
        child.kill(signal);
      }
      try { await bounded(status, `reap PID ${child.pid}`, 2000); break; }
      catch { /* The outer marker sweep handles a child that cannot be reaped here. */ }
    }
    throw error;
  }
}

function bounded(promise, what, milliseconds = settings.timeoutMs) {
  const timeout = new AbortController();
  const deadline = sleep(milliseconds, null, { signal: timeout.signal }).then(() => { throw new Error(`timed out: ${what}`); });
  return Promise.race([promise, deadline]).finally(() => timeout.abort());
}

const checkClosed = (port) => assert.equal(command('ss', '-H', '-ltn', `sport = :${port}`), '', `port ${port} still listening`);
const parentPID = (pid) => Number(fs.readFileSync(`/proc/${pid}/status`, 'utf8').match(/^PPid:\s+(\d+)$/m)?.[1]);
const rss = (pid) => {
  const kib = Number(fs.readFileSync(`/proc/${pid}/status`, 'utf8').match(/^VmRSS:\s+(\d+)\s+kB$/m)?.[1]);
  assert(kib > 0, `missing RSS for ${pid}`);
  return kib;
};

function readinessFixture(shim) {
  const { home, state, port, child, env } = shim;
  const plugins = path.join(home, '.claude/plugins');
  fs.mkdirSync(plugins, { recursive: true });
  fs.writeFileSync(path.join(plugins, 'installed_plugins.json'), JSON.stringify({ plugins: { 'model-gateway@fixture': [{ version: pluginVersion, installPath: plugin }] } }));
  fs.writeFileSync(path.join(state, 'guardian.pid'), String(child.pid));
  fs.writeFileSync(path.join(state, 'guardian.pid.json'), JSON.stringify({ pid: child.pid, command: `node "${cli}" serve-shim` }));
  const { file } = writeCommandLauncher({ home });
  const hookEnv = { ...env, CODEX_GATEWAY_PORT: String(port), CODEX_GATEWAY_WORKER_PORT: String(port), ANTHROPIC_BASE_URL: portURL(port) };
  const payload = JSON.stringify({ hook_event_name: 'UserPromptSubmit', cwd: home });
  return { env: hookEnv, invoke: async () => {
    const began = performance.now();
    const hook = spawn(node, [file, 'readiness-gate'], { cwd: home, env: hookEnv, stdio: ['pipe', 'pipe', 'pipe'] });
    let output = '';
    hook.stdout.on('data', (c) => { output += c; });
    hook.stderr.on('data', (c) => { output += c; });
    hook.stdin.on('error', (error) => { output += error.message; });
    hook.stdin.end(payload);
    const [code, signal] = await reapChild(hook, once(hook, 'close'), 'readiness gate');
    const ms = elapsed(began);
    assert.equal(code, 0, `readiness gate: ${output} (signal ${signal})`);
    assert.equal(output, '', 'readiness gate was not quiet');
    return ms;
  } };
}

async function measure(shim, index) {
  const hook = readinessFixture(shim);
  const sample = (action, boundary, values) => records.push(record('load', { series: index, action, boundary, ...values }));
  records.push(record('environment', { series: index, supervisor: envForReport(shim.env), readiness: envForReport(hook.env), workerPort: shim.workerPort }));
  sample('readiness', 'start', load());
  for (let i = 0; i < settings.warmups + settings.readinessRuns; i++) {
    records.push(record('readiness', { series: index, sample: i, warmup: i < settings.warmups, wallMs: await hook.invoke() }));
  }
  sample('readiness', 'end', load());
  sample('ttfb', 'start', load());
  for (let i = 0; i < settings.warmups + settings.ttfbRuns; i++) {
    const result = await request(shim.port, '/v1/messages', bigBody);
    assert.equal(result.status, 200);
    assert.equal(result.body, response, 'response was not the entire fixture SSE stream');
    assert(result.ttfbMs > 0);
    records.push(record('ttfb', { series: index, sample: i, warmup: i < settings.warmups, ttfbMs: result.ttfbMs }));
  }
  sample('ttfb', 'end', load());
  sample('rss', 'start', load());
  const began = performance.now();
  // Node timers can fire slightly early relative to the monotonic clock.
  for (let remaining = settings.idleMs; remaining > 0; remaining = settings.idleMs - elapsed(began)) {
    await sleep(Math.ceil(remaining));
  }
  const idleMs = elapsed(began);
  const { pid } = shim.child;
  assert.equal(parentPID(shim.workerPid), pid);
  const supervisorKiB = rss(pid), workerKiB = rss(shim.workerPid);
  records.push(record('rss', { series: index, idleMs, supervisorKiB, workerKiB, sumKiB: supervisorKiB + workerKiB }));
  sample('rss', 'end', load());
}

async function disconnect(topology, provider, fake, stage) {
  const key = `${topology.name}-${provider}-${stage}`;
  const timeline = [];
  const probe = {
    stage, requests: 0, providerRequestBytes: 0, providerResponseBytes: 0,
    note: (event, fields = {}) => timeline.push({ event, time: performance.now(), ...fields }),
  };
  const uploaded = new Promise((resolve) => { probe.signalUpload = resolve; });
  fake.probes.set(key, probe);
  const body = payload(models[provider]);
  const peer = net.createConnection({ host: loopback, port: topology.port });
  peer.on('error', (err) => probe.note('client-error', { code: err.code }));
  const closed = new Promise((resolve) => peer.once('close', (hadError) => { probe.note('client-close', { hadError }); resolve(); }));
  let received = '';
  let clientWireBytes = 0;
  const data = new Promise((resolve) => peer.on('data', (chunk) => {
    clientWireBytes += chunk.length;
    received += chunk.toString();
    probe.note('client-data', { bytes: chunk.length });
    if (received.includes('event: message_start')) resolve();
  }));
  try {
    await bounded(once(peer, 'connect'), key);
    const upload = stage === 'before-upload-end' ? body.slice(0, Math.floor(body.length / 2)) : body;
    await new Promise((resolve, reject) => peer.write(
      `POST /v1/messages HTTP/1.1\r\nHost: ${loopback}:${topology.port}\r\nContent-Type: application/json\r\nContent-Length: ${body.length}\r\nX-Bench-Probe: ${key}\r\n\r\n${upload}`,
      (error) => error ? reject(error) : resolve(),
    ));
    probe.note('client-upload', { bytes: upload.length, declaredBytes: body.length });
    if (stage !== 'before-upload-end') await bounded(uploaded, key);
    if (stage === 'mid-stream') await bounded(data, key);
    else await sleep(settings.headersSettleMs);
    const zero = performance.now();
    timeline.push({ event: 'client-disconnect', time: zero });
    peer.destroy();
    await bounded(closed, key);
    if (stage === 'awaiting-headers') {
      await sleep(settings.headersSettleMs);
      probe.releaseHeaders();
    }
    if (probe.upstream) void sendTail(probe);
    await sleep(Math.max(0, settings.observationMs - elapsed(zero)));
    const observationMs = elapsed(zero);
    const events = timeline.map(({ time, ...e }) => ({ ...e, offsetMs: Number((time - zero).toFixed(6)) }));
    // Reuse of an open connection after a completed response is not a stalled stream.
    const outcome = {
      requests: probe.requests, requestBytes: probe.providerRequestBytes, responseBytesWritten: probe.providerResponseBytes,
      responseFinished: events.some((e) => e.event === 'provider-response-finish'),
      socketClosed: events.some((e) => e.event === 'provider-socket-close'),
      blockedForMs: probe.blockedSince === undefined ? null : elapsed(probe.blockedSince),
    };
    return record('disconnect', { topology: topology.name, model: models[provider], stage, observationMs, provider: outcome,
      client: { wireBytes: clientWireBytes, status: Number(received.match(/^HTTP\/1\.1 (\d+)/)?.[1]) || null }, events });
  } finally {
    peer.destroy();
    if (probe.socket && !probe.socket.destroyed) {
      const close = once(probe.socket, 'close');
      probe.socket.destroy();
      await bounded(close, `close fake upstream for ${key}`);
    }
    fake.probes.delete(key);
  }
}

async function sendTail(probe) {
  const res = probe.upstream;
  const block = ': ' + 'x'.repeat(settings.pressureBlockBytes - 4) + '\n\n';
  try {
    while (!res.destroyed && probe.providerResponseBytes < settings.pressureBytes) {
      const remaining = settings.pressureBytes - probe.providerResponseBytes;
      const chunk = remaining >= block.length ? block : block.slice(0, remaining - 2) + '\n\n';
      const ready = res.write(chunk);
      probe.providerResponseBytes += Buffer.byteLength(chunk);
      if (!ready) {
        const began = performance.now();
        probe.blockedSince = began;
        // A false write alone is only Node's writable high-water mark; log
        // long blocked writes in addition to progress and finish.
        await new Promise((resolve) => {
          const done = () => { res.off('drain', done); res.off('close', done); resolve(); };
          res.once('drain', done);
          res.once('close', done);
        });
        delete probe.blockedSince;
        const waitMs = elapsed(began);
        if (waitMs >= settings.headersSettleMs) probe.note('provider-write-unblocked', { waitMs });
      }
    }
    if (!res.destroyed) res.end(frame('message_stop', {}));
  } catch (error) { probe.note('provider-write-error', { code: error.code ?? error.message }); }
}

async function upgrade(topology) {
  const began = performance.now();
  const peer = net.createConnection({ host: loopback, port: topology.port });
  const chunks = [];
  peer.on('data', (chunk) => chunks.push(chunk));
  try {
    await bounded(once(peer, 'connect'), 'upgrade connect');
    const close = once(peer, 'close');
    peer.write(`GET /healthz HTTP/1.1\r\nHost: ${loopback}:${topology.port}\r\nConnection: Upgrade, close\r\nUpgrade: fixture\r\n\r\n`);
    await bounded(close, 'upgrade response');
    const wire = Buffer.concat(chunks);
    const split = wire.indexOf('\r\n\r\n');
    const head = (split === -1 ? wire : wire.subarray(0, split)).toString('latin1');
    return record('upgrade', { topology: topology.name, elapsedMs: elapsed(began), wireBytes: wire.length, head,
      wireBase64: wire.toString('base64') });
  } finally { peer.destroy(); }
}

async function main() {
  const cleanup = [], errors = [];
  let usage;
  try {
    const anthropic = await fakeUpstream('anthropic', cleanup);
    const codex = await fakeUpstream('codex', cleanup);
    usage = await fakeUpstream('usage', cleanup);
    const providers = { anthropic, codex };
    const upstreams = { ...providers, usage };
    const cores = new Set(command('lscpu', '-p=SOCKET,CORE').split('\n').filter((line) => /^\d+,\d+$/.test(line))).size;
    assert(cores > 0, 'no processor topology from lscpu');
    records.push(record('run', { ...run, started: date(), machine: { cpu: os.cpus()[0].model, logicalCPUs: os.cpus().length, cores,
      availableCPUs: os.availableParallelism(), memoryBytes: os.totalmem(), kernel: command('uname', '-srvm'),
      node: process.version, npm: command('npm', '--version'),
      ajv: require(path.join(plugin, 'node_modules/ajv/package.json')).version },
      env: envForReport(process.env), npmCache: '$WORK/npm-cache',
      providers: Object.fromEntries(Object.entries(upstreams).map(([name, fake]) => [name, fake.port])),
      responseBytes }));
    for (let i = 1; i <= settings.series; i++) {
      const shim = gateway('serve-shim', path.join(work, `shim-${i}`), upstreams);
      try { await shim.ready(); await measure(shim, i); }
      finally { await shim.stop(); }
    }
    for (const [name, startCommand] of [['direct', 'serve-worker'], ['relayed', 'serve-shim']]) {
      const topology = gateway(startCommand, path.join(work, name), upstreams);
      topology.name = name;
      try {
        await topology.ready();
        records.push(record('probe-environment', { topology: name, gateway: envForReport(topology.env),
          clientPort: topology.port, workerPort: topology.workerPort }));
        for (const [provider, fake] of Object.entries(providers)) {
          for (const stage of ['before-upload-end', 'awaiting-headers', 'headers-only', 'mid-stream']) {
            records.push(await disconnect(topology, provider, fake, stage));
          }
        }
        records.push(await upgrade(topology));
      } finally { await topology.stop(); }
    }
  } catch (error) {
    errors.push(error);
  } finally {
    for (const result of await Promise.allSettled(cleanup.map((close) => close()))) {
      if (result.status === 'rejected') errors.push(result.reason);
    }
  }
  if (errors.length) throw new AggregateError(errors, 'benchmark job failed');
  assert.equal(usage.usagePosts(), settings.series * (settings.warmups + settings.ttfbRuns), 'expected one usage record per completed stream');
  records.push(record('end', { ended: date(), ownedProcessesAndListenersGone: true, usagePosts: usage.usagePosts() }));
  const payload = gzipSync(records.map((r) => JSON.stringify(r)).join('\n') + '\n');
  process.stdout.write(`NODE-BENCH-V1 ${createHash('sha256').update(payload).digest('hex')} ${payload.toString('base64')}\n`);
}
main().catch((error) => { console.error(error); process.exitCode = 1; });
JS
}

# Invoked by the EXIT trap.
# shellcheck disable=SC2329
cleanup() {
    local rc=$? result='' stamp log
    local -a logs=()
    trap '' HUP INT TERM
    if (( interrupted )) || [[ -n $work && -e $work/interrupted ]]; then rc=1; fi
    if [[ -z $work ]]; then exit "$rc"; fi
    for log in "$work/supervisor.log" "$work/job.log"; do
        if [[ -f $log ]]; then logs+=("$log"); fi
    done
    # The supervisor has completed containment. Deliver buffered diagnostics
    # like other venue targets, even if the remote reader delays delivery.
    if (( ${#logs[@]} )) && ! cat -- "${logs[@]}" 9<&- >&2; then rc=1; fi
    if (( rc == 0 )); then
        if ! timeout --kill-after=1s 10s "$root/hack/venue-check" 9<&- ||
           ! IFS= read -r result < "$work/result" || [[ $result != NODE-BENCH-V1\ * ]]; then
            printf 'bench: missing valid evidence or venue check failed\n' >&2
            rc=1
        fi
    fi
    # Only the benchmark's private scratch belongs to this script. The
    # remote runner retains its separate staging tree on failure for diagnosis.
    if timeout --kill-after=1s 10s rm -rf -- "$work" 9<&- && [[ ! -e $work && ! -L $work ]]; then
        printf 'bench: removed private scratch %s\n' "$work" >&2
    else
        printf 'bench: private scratch remains: %s\n' "$work" >&2
        rc=1
    fi
    if stamp=$(timeout --kill-after=1s 2s date -u '+%Y-%m-%dT%H:%M:%S.%NZ' 9<&-); then
        printf 'bench: run %s ended at %s (exit %s)\n' "${work##*/}" "$stamp" "$rc" >&2
    else
        rc=1
    fi
    if (( rc == 0 )); then printf '%s\n' "$result"; fi
    exit "$rc"
}

# Invoked by the signal traps. A file is reliable even if the supervisor has
# not yet installed its signal handlers, or a signal arrives during the fork.
# shellcheck disable=SC2329
interrupt() {
    interrupted=1
    if [[ -n $work ]]; then : > "$work/interrupted"; fi
}

umask 077
work=''
interrupted=0
trap cleanup EXIT
trap interrupt HUP INT TERM
# Let mktemp return the path it owns even if a signal reaches the whole group.
work=$(trap '' HUP INT TERM; exec mktemp -d "${TMPDIR:-/tmp}/gateway-bench.XXXXXXXX" 9<&-)
(( interrupted == 0 )) || exit 1
job=$(declare -f run_job)
# The run starts only after subreaping is established. Neither the supervisor
# nor its children inherit the remote runner's flock descriptor. Keep both
# streams private so containment cannot wait for the output reader.
supervise_job "$job" "$root" "$work" 9<&- > "$work/supervisor.log" 2>&1 &
pid=$!
rc=0
wait "$pid" || rc=$?
if (( interrupted )); then
    # A trapped signal interrupts Bash's wait, not the supervisor's cleanup.
    # That cleanup has its own deadline and completes before scratch removal.
    trap '' HUP INT TERM
    wait "$pid" || :
    exit 1
fi
exit "$rc"

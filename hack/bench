  assert.equal(result.stderr, '', `lsof for port ${port} wrote to stderr`);
  assert.equal(result.status, 0, `lsof for port ${port}: exit ${result.status}, signal ${result.signal}`);
  const lines = result.stdout.split('\n');
  assert.equal(lines.pop(), '', 'lsof output does not end with a newline');

  for (const line of lines) {
    let match;
    if ((field === 'p' || field === 'pf') && (match = /^p([0-9]+)$/.exec(line))) { owner = Number(match[1]); field = 'f'; continue; }
    if ((field === 'f' || field === 'pf') && /^f[0-9]+$/.test(line)) { field = 'n'; continue; }
    match = field === 'n' && /^n(.*):([0-9]+)$/.exec(line);
    assert(match, `unexpected lsof line: ${JSON.stringify(line)}`);
    const [, address, listened] = match;
    assert(address === '*' || net.isIP(address.replace(/^\[(.*)\]$/, '$1').replace(/%[\w.-]+$/, '')) !== 0, `unexpected lsof address: ${JSON.stringify(line)}`);
    if (owner === process.pid && address === loopback && Number(listened) === canaryPort) canarySeen = true;
    else if (Number(listened) === port) holders.push({ pid: owner, address });

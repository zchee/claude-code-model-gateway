# GNU timeout on Linux. macOS has none; the bounded runner there applies the
# same limits to the command's whole process group and forwards signals.
# shellcheck disable=SC2329
bounded() {
    local seconds=$1
    shift
    if [[ $system == Linux ]]; then
        timeout --kill-after=1s "${seconds}s" "$@"
    else
        python3 -I -c "$darwin_program" bounded "$seconds" "$@"
    fi
}

# Invoked by the EXIT trap.
# shellcheck disable=SC2329
cleanup() {
    local rc=$? result='' stamp log status
    local -a logs=()
    trap '' HUP INT TERM
    if (( interrupted )) || [[ -n $work && -e $work/interrupted ]]; then rc=1; fi
    if [[ -z $work ]]; then exit "$rc"; fi
    for log in "${logs_dir:-$work}/supervisor.log" "${logs_dir:-$work}/job.log"; do
        if [[ -f $log ]]; then logs+=("$log"); fi
    done
    # The supervisor has completed containment. Deliver buffered diagnostics
    # like other venue targets, even if the remote reader delays delivery.
    if (( ${#logs[@]} )) && ! cat -- "${logs[@]}" 9<&- >&2; then rc=1; fi
    if (( rc == 0 )); then
        if ! bounded 10 "$root/hack/venue-check" 9<&- ||
           ! IFS= read -r result < "$work/result" || [[ $result != NODE-BENCH-V1\ * ]]; then
            printf 'bench: missing valid evidence or venue check failed\n' >&2
            rc=1
        fi
    fi
    # Only the benchmark's private scratch belongs to this script. The
    # remote runner retains its separate staging tree on failure for diagnosis.
    if bounded 10 rm -rf -- "$work" 9<&- && [[ ! -e $work && ! -L $work ]]; then
        printf 'bench: removed private scratch %s\n' "$work" >&2
    else
        printf 'bench: private scratch remains: %s\n' "$work" >&2
        rc=1
    fi
    if stamp=$(bounded 2 "${utc_stamp[@]}" 9<&-); then
        printf 'bench: run %s ended at %s (exit %s)\n' "${work##*/}" "$stamp" "$rc" >&2
    else
        rc=1
    fi
    if [[ -n $artifact ]]; then
        if (( rc == 0 )); then status=complete; else status="incomplete (exit $rc)"; fi
        printf '%s\n' "$status" > "$artifact/status" || rc=1
    fi
    if (( rc == 0 )); then printf '%s\n' "$result"; fi
    exit "$rc"
}

# Invoked by the signal traps. A file is reliable even if the supervisor has
# not yet installed its signal handlers, or a signal arrives during the fork.
# shellcheck disable=SC2329
interrupt() {
    interrupted=1
    if [[ -n $work ]]; then : > "$work/interrupted"; fi
}

umask 077
utc_stamp=(date -u '+%Y-%m-%dT%H:%M:%S.%NZ')
scratch=${TMPDIR:-/tmp}
supervisor=supervise_job
if [[ $system == Darwin ]]; then
    # BSD date has no fractional seconds.
    # shellcheck disable=SC2016
    utc_stamp=(perl -MPOSIX=strftime -MTime::HiRes=gettimeofday -e
        '($s, $us) = gettimeofday; printf "%s.%06dZ\n", strftime("%Y-%m-%dT%H:%M:%S", gmtime $s), $us')
    # The run's Unix socket lives in this directory. A macOS socket path holds
    # at most 103 bytes, the runner's TMPDIR is long, and /tmp is a symlink.
    scratch=/private/tmp
    supervisor=supervise_job_darwin
fi
work=''
logs_dir=''
interrupted=0
trap cleanup EXIT
trap interrupt HUP INT TERM
# Let mktemp return the path it owns even if a signal reaches the whole group.
work=$(trap '' HUP INT TERM; exec mktemp -d "$scratch/gateway-bench.XXXXXXXX" 9<&-)
(( interrupted == 0 )) || exit 1
logs_dir=$work
if [[ $system == Darwin ]]; then
    # The attempt's logs and partial samples go straight to the artifact
    # directory when there is one; the evidence frame stays in the scratch.
    logs_dir=$work/attempt
    if [[ -n $artifact ]]; then ln -s -- "$artifact" "$logs_dir"; else mkdir -- "$logs_dir"; fi
    printf '%s\n' "$job_name" > "$work/job-name"
fi
job=$(declare -f run_job)
# The run starts only after subreaping (on macOS, the pre-run process
# snapshot) is established. Neither the supervisor nor its children inherit
# the remote runner's flock descriptor. Keep both streams private so
# containment cannot wait for the output reader.
"$supervisor" "$job" "$root" "$work" 9<&- > "$logs_dir/supervisor.log" 2>&1 &
pid=$!
rc=0
wait "$pid" || rc=$?
if (( interrupted )); then
    # A trapped signal interrupts Bash's wait, not the supervisor's cleanup.
    # That cleanup has its own deadline and completes before scratch removal.
    trap '' HUP INT TERM
    wait "$pid" || :
    exit 1
fi
exit "$rc"

# Checks the evidence of one hack/bench run against the fixed measurement
# contract; it reads files and starts no process besides the pin printer.
#
#   baseline-bench verify --platform linux|darwin [--job <label>] full|half-close <run output> [<new JSON Lines file>]
#       finds the one NODE-BENCH-V1 frame, checks its checksum and every required
#       observation, and optionally writes the decoded records byte for byte.
#   baseline-bench check --platform linux|darwin [--job <label>] full|half-close <JSON Lines file>
#       the same checks for records already decoded, such as committed samples.
#   With --job, the run record's commands.job must be exactly <label>. Labels
#   that start with "--" are reserved: such a value is a usage error.
#   baseline-bench summary --platform linux|darwin <JSON Lines file of a full run>
#       prints the latency and resident memory tables of docs/port/baseline-node.md.

set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
pin=$("$root/hack/pinned-source" --print-pin)
python3 -I - "$pin" "$@" <<'PY'
import base64
import binascii
import hashlib
import json
import math
import os
import re
import stat
import sys
import zlib

# The measurement contract. A run with other settings is not this baseline,
# however truthfully its header describes it.
NODE = 'v24.11.1'
SETTINGS = {
    'series': 3, 'warmups': 1, 'readinessRuns': 50, 'ttfbRuns': 200,
    'requestBytes': 1048576, 'events': 2000, 'idleMs': 60000,
    'timeoutMs': 15000, 'headersSettleMs': 100, 'observationMs': 1500,
    'pressureBytes': 16777216, 'pressureBlockBytes': 65536,
}
HALF_CLOSE_SETTINGS = {'runs': 5, 'settleMs': 100, 'answerDelayMs': 100, 'bodyDelayMs': 200, 'observationMs': 1500}
DISCONNECT_CASES = 16
UPGRADE_CAPTURES = 2
RSS_OBSERVATIONS = 3
CONTAINMENT = ('containment by runner teardown and marker sweep; '
               'absence of unmarked detached descendants not proven')
# What the macOS sweep states; its counts are separate members, and a free-text
# member named note is not interpreted.
SWEEP = 'marked, grouped and descendant processes of the job: none observed'
MIN_EMPTY_SCANS = 3
MIN_SCAN_INTERVAL_MS = 100
HALF_CLOSE_FIELDS = {'type', 'topology', 'model', 'scenario', 'clientKind', 'run', 'observationMs', 'provider', 'client', 'events'}
HALF_CLOSE_PROVIDER = {'requests', 'requestBytes', 'responseBytesWritten', 'outcome', 'outcomeEvent', 'outcomeMs', 'socketClosed', 'socketCloseMs'}
HALF_CLOSE_CLIENT = {'wireBytes', 'wireSHA256', 'statusLine', 'head', 'framing', 'bodyBytes', 'terminated', 'framingError', 'excessBytes',
                     'bodyMatches', 'bodyComplete', 'end', 'errorCode', 'firstByteMs', 'firstEventMs', 'inputEndMs', 'closeMs'}
DARWIN_RSS = 'darwin-ps-rss-kib'
MODELS = ('claude-sonnet-4-6', 'claude-gpt-5.6-sol')
STAGES = ('before-upload-end', 'awaiting-headers', 'headers-only', 'mid-stream')
TOPOLOGIES = ('direct', 'relayed')
SCENARIOS = ('answer-pending', 'headers-after-fin', 'mid-stream')
CLIENTS = ('half-close', 'control')
# Node timers can fire a few milliseconds early against the monotonic clock.
TIMER_SLACK_MS = 10
# Each input is refused before more than its cap is read: the run output or
# records file, the Base64 frame within it, and the records it decodes to.
MAX_INPUT_BYTES = 16 * 1024 * 1024
MAX_FRAME_BYTES = 12 * 1024 * 1024
MAX_DECODED_BYTES = 64 * 1024 * 1024
UTC = re.compile(r'^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{6,9}Z$')
STATUS_LINE = re.compile(r'^HTTP/1\.[01] [1-5][0-9]{2}(?: [^\r\n]*)?$')
FIELD_LINE = re.compile(r"^[!#$%&'*+.^_`|~0-9A-Za-z-]+:[^\r\n]*$")
assert SETTINGS['series'] == RSS_OBSERVATIONS
assert len(TOPOLOGIES) * len(MODELS) * len(STAGES) == DISCONNECT_CASES and len(TOPOLOGIES) == UPGRADE_CAPTURES


class Invalid(Exception):
    pass


def require(ok, reason):
    if not ok:
        raise Invalid(reason)


def strict_object(pairs):
    seen = set()
    for name, _ in pairs:
        require(name not in seen, f'duplicate field in object: {name!r:.60}')
        seen.add(name)
    return dict(pairs)


def no_constant(name):
    raise Invalid(f'non-finite number {name}')


def finite_float(literal):
    # An exponent can overflow to infinity without any NaN or Infinity token.
    value = float(literal)
    require(math.isfinite(value), f'non-finite number {literal[:40]}')
    return value


def decode(raw):
    require(len(raw) <= MAX_DECODED_BYTES, 'decoded records exceed the size limit')
    require(raw.endswith(b'\n'), 'records do not end with a newline')
    records = []
    for number, line in enumerate(raw.split(b'\n')[:-1], 1):
        try:
            value = json.loads(line, object_pairs_hook=strict_object, parse_constant=no_constant, parse_float=finite_float)
        except ValueError as error:
            raise Invalid(f'line {number} is not JSON: {error}')
        require(isinstance(value, dict) and isinstance(value.get('type'), str), f'line {number} has no record type')
        records.append(value)
    return records


def integer(value, low=None, high=None):
    return type(value) is int and (low is None or value >= low) and (high is None or value <= high)


def number(value, low=None):
    return type(value) in (int, float) and math.isfinite(value) and (low is None or value >= low)


def text(value):
    return isinstance(value, str) and value != ''


def optional(check, value):
    return value is None or check(value)


def utc(value):
    return isinstance(value, str) and UTC.match(value) is not None


def port(value):
    return integer(value, 1, 65535)


# The launch environments the harness declares: what run_job passes in, what
# each gateway gets on top of it, and what the readiness hook adds.
LAUNCH_ENV = ('PATH', 'HOME', 'TMPDIR', 'LC_ALL', 'MODEL_GATEWAY_BENCH_RUN')
GATEWAY_ENV = LAUNCH_ENV + ('CODEX_GATEWAY_PORT', 'CODEX_GATEWAY_WORKER_PORT', 'CODEX_GATEWAY_COMPAT_PORT', 'CODEX_GATEWAY_PROXY_PORT',
                            'CODEX_GATEWAY_ANTHROPIC_UPSTREAM', 'CODEX_GATEWAY_USAGE_ENDPOINT', 'CODEX_GATEWAY_HOSTS_FILE',
                            'CODEX_GATEWAY_SOCKET_PATH', 'CODEX_GATEWAY_CLAUDE_BIN')
READINESS_ENV = GATEWAY_ENV + ('ANTHROPIC_BASE_URL',)


def exact_env(value, keys, where):
    # Exactly the declared keys, each with a string value. A message names a
    # key, never a value.
    require(isinstance(value, dict), f'{where}: no environment map')
    extra = sorted(name for name in value if name not in keys)
    if extra:
        raise Invalid(f'{where}: the environment has an undeclared key {extra[0]!r:.80}')
    missing = [name for name in keys if name not in value]
    if missing:
        raise Invalid(f'{where}: the environment lacks the declared key {missing[0]}')
    wrong = [name for name, item in value.items() if not isinstance(item, str)]
    if wrong:
        raise Invalid(f'{where}: the environment value of {wrong[0]!r:.80} is not a string')


def events_of(record, where):
    events = record.get('events')
    require(isinstance(events, list) and events, f'{where}: no event timeline')
    for event in events:
        require(isinstance(event, dict) and text(event.get('event')) and number(event.get('offsetMs')),
                f'{where}: invalid event {event!r:.120}')
    return events


def offset(events, name):
    return next((e['offsetMs'] for e in events if e['event'] == name), None)


def check_run(run, mode, platform, pin):
    require(run.get('type') == 'run', 'the first record is not the run record')
    require([run.get(k) for k in ('commit', 'rootTree', 'pluginTree')] == pin, 'the run does not name the pinned commit and tree hashes')
    require(text(run.get('pluginVersion')), 'run: no plugin version')
    require(isinstance(run.get('commands'), dict) and run['commands'] and all(text(v) for v in run['commands'].values()), 'run: invalid commands table')
    require(run.get('settings') == SETTINGS and all(integer(v) for v in run['settings'].values()), 'run: settings differ from the measurement contract')
    if mode == 'full':
        require('probe' not in run and 'halfCloseSettings' not in run, 'the run is not a full run')
    else:
        require(run.get('probe') == 'half-close', 'the run is not a half-close run')
        require(run.get('halfCloseSettings') == HALF_CLOSE_SETTINGS and all(integer(v) for v in run['halfCloseSettings'].values()),
                'run: half-close settings differ from the measurement contract')
    require(utc(run.get('started')), 'run: no UTC start time')
    machine = run.get('machine')
    require(isinstance(machine, dict), 'run: no machine inventory')
    require(machine.get('node') == NODE, f'Node is {machine.get("node")!r}, not {NODE}')
    for name in ('cpu', 'kernel', 'npm', 'ajv'):
        require(text(machine.get(name)), f'run: machine has no {name}')
    for name in ('logicalCPUs', 'cores', 'availableCPUs', 'memoryBytes'):
        require(integer(machine.get(name), 1), f'run: machine {name} is not a positive integer')
    kernel = machine['kernel']
    require(kernel.startswith('Darwin ' if platform == 'darwin' else 'Linux '), f'the run is not a {platform} run: {kernel!r}')
    if platform == 'darwin':
        system = machine.get('system')
        require(isinstance(system, dict) and all(text(system.get(k)) for k in ('version', 'build', 'model')), 'run: no macOS system inventory')
    else:
        require('system' not in machine, 'run: a Linux record with a macOS system inventory')
    exact_env(run.get('env'), LAUNCH_ENV, 'run')
    require(run['env']['MODEL_GATEWAY_BENCH_RUN'] == '$WORK',
            'run: invalid environment record')
    require(run.get('npmCache') == '$WORK/npm-cache', 'run: unexpected npm cache')
    providers = run.get('providers')
    require(isinstance(providers, dict) and set(providers) == {'anthropic', 'codex', 'usage'} and all(port(p) for p in providers.values()),
            'run: invalid fake provider ports')
    require(integer(run.get('responseBytes'), 1), 'run: no response size')


INTEGER_KEYS = {'series', 'sample', 'run'}


def keyed(records, kind, fields):
    # Key fields are typed before they are compared: in a tuple, True equals
    # 1 and 0.0 equals 0.
    rows = [r for r in records if r['type'] == kind]
    for r in rows:
        for f in fields:
            require(integer(r.get(f), 0) if f in INTEGER_KEYS else text(r.get(f)), f'{kind}: invalid key field {f}: {r.get(f)!r:.60}')
    keys = [tuple(r.get(f) for f in fields) for r in rows]
    require(len(keys) == len(set(keys)), f'duplicate {kind} records')
    return rows, set(keys)


def check_samples(records, kind, value, count):
    rows, keys = keyed(records, kind, ('series', 'sample'))
    want = {(s, n) for s in range(1, SETTINGS['series'] + 1) for n in range(SETTINGS['warmups'] + count)}
    require(keys == want, f'{kind}: {len(want - keys)} samples missing, {len(keys - want)} unexpected')
    for r in rows:
        require(set(r) == {'type', 'series', 'sample', 'warmup', value} and r['warmup'] is (r['sample'] < SETTINGS['warmups']) and
                number(r[value]) and r[value] > 0, f'{kind}: invalid sample {r!r:.160}')
    return len(rows)


def check_disconnects(records):
    rows, keys = keyed(records, 'disconnect', ('topology', 'model', 'stage'))
    require(keys == {(t, m, g) for t in TOPOLOGIES for m in MODELS for g in STAGES}, f'disconnect: {len(keys & {(t, m, g) for t in TOPOLOGIES for m in MODELS for g in STAGES})} of {DISCONNECT_CASES} cases')
    for r in rows:
        where = f'disconnect {r["topology"]} {r["model"]} {r["stage"]}'
        require(set(r) == {'type', 'topology', 'model', 'stage', 'observationMs', 'provider', 'client', 'events'}, f'{where}: record members differ from the harness record')
        require(number(r.get('observationMs')) and r['observationMs'] >= SETTINGS['observationMs'] - TIMER_SLACK_MS, f'{where}: observation window')
        provider, client = r.get('provider'), r.get('client')
        require(isinstance(provider, dict) and set(provider) == {'requests', 'requestBytes', 'responseBytesWritten', 'responseFinished', 'socketClosed', 'blockedForMs'},
                f'{where}: no provider outcome')
        require(integer(provider['requests'], 0) and integer(provider['requestBytes'], 0) and integer(provider['responseBytesWritten'], 0) and
                type(provider['responseFinished']) is bool and type(provider['socketClosed']) is bool and optional(lambda v: number(v, 0), provider['blockedForMs']),
                f'{where}: invalid provider outcome')
        require(isinstance(client, dict) and set(client) == {'wireBytes', 'status'} and integer(client['wireBytes'], 0) and
                optional(lambda v: integer(v, 100, 599), client['status']) and (client['status'] is None or client['wireBytes'] > 0),
                f'{where}: invalid client outcome')
        events = events_of(r, where)
        names = {e['event'] for e in events}
        # Events the harness itself causes or waits for before it disconnects.
        required = {'client-upload', 'client-disconnect', 'client-close'}
        if r['stage'] != 'before-upload-end':
            required |= {'provider-request', 'provider-upload-end'}
            require(provider['requests'] >= 1, f'{where}: the provider saw no request the harness waited for')
            require('provider-headers' in names or 'provider-headers-skipped' in names, f'{where}: no provider header attempt')
        if r['stage'] == 'mid-stream':
            required |= {'provider-first-event', 'client-data'}
        require(required <= names, f'{where}: missing events {sorted(required - names)}')
        require(offset(events, 'client-disconnect') == 0, f'{where}: the disconnect is not time zero')
        require(provider['responseFinished'] == ('provider-response-finish' in names) and provider['socketClosed'] == ('provider-socket-close' in names),
                f'{where}: provider outcome disagrees with its events')
    return len(rows)


def check_upgrades(records):
    rows, keys = keyed(records, 'upgrade', ('topology',))
    require(keys == {(t,) for t in TOPOLOGIES}, f'upgrade: {len(keys)} of {UPGRADE_CAPTURES} captures')
    for r in rows:
        where = f'upgrade {r["topology"]}'
        require(set(r) == {'type', 'topology', 'elapsedMs', 'wireBytes', 'head', 'wireBase64'} and number(r['elapsedMs']) and r['elapsedMs'] > 0,
                f'{where}: invalid record')
        try:
            wire = base64.b64decode(r['wireBase64'], validate=True)
        except (binascii.Error, TypeError) as error:
            raise Invalid(f'{where}: wire is not Base64: {error}')
        require(integer(r['wireBytes'], 1) and r['wireBytes'] == len(wire), f'{where}: wire size disagrees')
        split = wire.find(b'\r\n\r\n')
        require(split > 0, f'{where}: the capture holds no complete response head')
        require(r['head'] == wire[:split].decode('latin1'), f'{where}: the recorded head differs from the wire')
        lines = r['head'].split('\r\n')
        require(STATUS_LINE.match(lines[0]) is not None and all(FIELD_LINE.match(line) for line in lines[1:]), f'{where}: malformed response head')
    return len(rows)


def check_half_close(records):
    rows, keys = keyed(records, 'half-close', ('topology', 'scenario', 'clientKind', 'run'))
    want = {('relayed', c, k, n) for c in SCENARIOS for k in CLIENTS for n in range(1, HALF_CLOSE_SETTINGS['runs'] + 1)}
    require(keys == want, f'half-close: {len(want - keys)} probes missing, {len(keys - want)} unexpected')
    for r in rows:
        where = f'half-close {r["scenario"]} {r["clientKind"]} {r["run"]}'
        require(r.get('model') == MODELS[0], f'{where}: unexpected model')
        require(number(r.get('observationMs')) and r['observationMs'] >= HALF_CLOSE_SETTINGS['observationMs'] - TIMER_SLACK_MS, f'{where}: observation window')
        provider, client = r.get('provider'), r.get('client')
        # Every member the harness writes must be present, the nullable ones
        # too: an explicit null is an observation, a missing member is not.
        require(set(r) == HALF_CLOSE_FIELDS, f'{where}: record members differ from the harness record')
        require(isinstance(provider, dict) and set(provider) == HALF_CLOSE_PROVIDER, f'{where}: provider members differ from the harness record')
        require(isinstance(client, dict) and set(client) == HALF_CLOSE_CLIENT, f'{where}: client members differ from the harness record')
        require(integer(provider.get('requests'), 1) and integer(provider.get('requestBytes'), 0) and
                integer(provider.get('responseBytesWritten'), 0) and provider.get('outcome') in ('completed', 'aborted', 'pending') and
                optional(text, provider.get('outcomeEvent')) and optional(number, provider.get('outcomeMs')) and
                type(provider.get('socketClosed')) is bool and optional(number, provider.get('socketCloseMs')), f'{where}: invalid provider outcome')
        require(isinstance(client, dict), f'{where}: no client outcome')
        require(integer(client.get('wireBytes'), 0) and isinstance(client.get('wireSHA256'), str) and re.fullmatch(r'[0-9a-f]{64}', client['wireSHA256']) and
                optional(lambda v: isinstance(v, str), client.get('statusLine')) and optional(lambda v: isinstance(v, str), client.get('head')) and
                client.get('framing') in (None, 'chunked', 'length', 'close') and integer(client.get('bodyBytes'), 0) and
                (client.get('terminated') is None or type(client.get('terminated')) is bool) and optional(text, client.get('framingError')) and integer(client.get('excessBytes'), 0) and
                type(client.get('bodyMatches')) is bool and type(client.get('bodyComplete')) is bool and
                client.get('end') in ('orderly', 'reset', 'error', 'open') and optional(text, client.get('errorCode')) and
                all(optional(number, client.get(k)) for k in ('firstByteMs', 'firstEventMs', 'inputEndMs', 'closeMs')), f'{where}: invalid client outcome')
        events = events_of(r, where)
        names = {e['event'] for e in events}
        zero = 'client-end-call' if r['clientKind'] == 'half-close' else 'client-end-call-withheld'
        required = {'client-upload', 'provider-request', 'provider-upload-end', zero}
        if r['scenario'] == 'mid-stream':
            required |= {'provider-first-event', 'client-first-event'}
        require(required <= names, f'{where}: missing events {sorted(required - names)}')
        require(offset(events, zero) == 0, f'{where}: the end call is not time zero')
        # The timeline of the client's write side and of the peer's FIN.
        if r['clientKind'] == 'half-close' and client['end'] not in ('reset', 'error'):
            require('client-write-side-finished' in names, f'{where}: the half-close never finished the write side')
        for field, name in (('inputEndMs', 'client-input-end'), ('closeMs', 'client-close'), ('firstByteMs', 'client-data'), ('firstEventMs', 'client-first-event')):
            require(client[field] == offset(events, name), f'{where}: {field} disagrees with the {name} event')
        require(provider['socketCloseMs'] == offset(events, 'provider-socket-close') and provider['socketClosed'] == (provider['socketCloseMs'] is not None),
                f'{where}: provider socket close disagrees with its events')
        terminal = next((e for e in events if e['event'] in ('provider-response-finish', 'provider-write-skipped', 'provider-headers-skipped') or
                         (e['event'] == 'provider-response-close' and e.get('finished') is False)), None)
        outcome = 'pending' if terminal is None else 'completed' if terminal['event'] == 'provider-response-finish' else 'aborted'
        require(provider['outcome'] == outcome and provider['outcomeEvent'] == (terminal and terminal['event']) and
                provider['outcomeMs'] == (terminal and terminal['offsetMs']), f'{where}: provider outcome disagrees with its events')
        # The relationships the harness computes between these members.
        errors = [e for e in events if e['event'] == 'client-error']
        require(all(isinstance(e.get('code'), str) for e in errors), f'{where}: a client-error event has no string code')
        require(client['errorCode'] == (errors[-1]['code'] if errors else None), f'{where}: errorCode is not the last client error')
        if client['errorCode'] is not None:
            end = 'reset' if client['errorCode'] == 'ECONNRESET' else 'error'
        else:
            end = 'orderly' if client['inputEndMs'] is not None else 'open'
        require(client['end'] == end, f'{where}: client end is {client["end"]!r}, its observations give {end!r}')
        complete = (client['bodyMatches'] and client['framingError'] is None and client['terminated'] is not False and
                    (client['terminated'] is True or end == 'orderly'))
        require(client['bodyComplete'] == complete, f'{where}: bodyComplete disagrees with bodyMatches, framingError, terminated and end')
        if client['head'] is None:
            # Without a complete head the status line is whatever came before
            # the first CRLF: a string, possibly empty, unless nothing came.
            require(client['wireBytes'] == 0 or isinstance(client['statusLine'], str),
                    f'{where}: a non-empty capture without a head has no status line')
            require(client['framing'] is None and client['bodyBytes'] == 0 and client['terminated'] is False and
                    client['framingError'] is None and client['excessBytes'] == 0 and client['bodyMatches'] is False,
                    f'{where}: a capture without a response head has body observations')
        else:
            require(client['framing'] is not None and client['statusLine'] == client['head'].split('\r\n')[0],
                    f'{where}: the status line is not the first line of the head')
        require((client['framing'] == 'close') == (client['terminated'] is None), f'{where}: terminated disagrees with the framing')
        if client['wireBytes'] == 0:
            require(client['statusLine'] is None and client['head'] is None and client['wireSHA256'] == hashlib.sha256(b'').hexdigest(),
                    f'{where}: an empty capture has a status line, head or digest')
    return len(rows)


def check(records, mode, platform, job=None):
    pin = sys.argv[1].split('\t')
    require(records, 'no records')
    check_run(records[0], mode, platform, pin)
    if job is not None:
        label = records[0]['commands'].get('job')
        if label != job:
            raise Invalid(f'the run is labelled {label!r:.120}, not {job!r:.120}')
    tail = ['end', 'cleanup'] if platform == 'darwin' else ['end']
    require([r['type'] for r in records[-len(tail):]] == tail, f'the run does not end with {" and ".join(tail)} records')
    end = records[-len(tail)]
    require(set(end) == {'type', 'ended', 'ownedProcessesAndListenersGone', 'usagePosts'} and utc(end['ended']) and
            end['ownedProcessesAndListenersGone'] is True and integer(end['usagePosts'], 0), 'invalid end record')
    counts = {kind: 1 for kind in ['run'] + tail}
    if platform == 'darwin':
        cleanup = records[-1]
        observations = cleanup.get('observations')
        require(set(cleanup) == {'type', 'checked', 'containment', 'observations'} and utc(cleanup['checked']) and cleanup['containment'] == CONTAINMENT,
                'the cleanup record does not state the macOS containment contract')
        require(isinstance(observations, dict) and
                isinstance(observations.get('note', ''), str) and
                set(observations) - {'note'} == {'sweep', 'consecutiveEmptyScans', 'scanIntervalMs', 'observedDuringCleanup', 'signaled', 'preRunProcesses'} and
                observations['sweep'] == SWEEP and integer(observations['consecutiveEmptyScans'], MIN_EMPTY_SCANS) and
                integer(observations['scanIntervalMs'], MIN_SCAN_INTERVAL_MS) and integer(observations['observedDuringCleanup'], 0) and
                integer(observations['signaled'], 0, 0) and integer(observations['preRunProcesses'], 1),
                'the cleanup record does not hold clean sweep observations')
    if mode == 'full':
        counts['readiness'] = check_samples(records, 'readiness', 'wallMs', SETTINGS['readinessRuns'])
        counts['ttfb'] = check_samples(records, 'ttfb', 'ttfbMs', SETTINGS['ttfbRuns'])
        series = range(1, SETTINGS['series'] + 1)
        rows, keys = keyed(records, 'rss', ('series',))
        require(keys == {(s,) for s in series}, f'rss: {len(rows)} of {RSS_OBSERVATIONS} observations')
        for r in rows:
            fields = {'type', 'series', 'idleMs', 'supervisorKiB', 'workerKiB', 'sumKiB'} | ({'metric'} if platform == 'darwin' else set())
            require(set(r) == fields and number(r['idleMs']) and r['idleMs'] >= SETTINGS['idleMs'], f'rss: series {r["series"]} did not idle {SETTINGS["idleMs"]} ms')
            require(integer(r['supervisorKiB'], 1) and integer(r['workerKiB'], 1) and integer(r['sumKiB'], 2) and r['sumKiB'] == r['supervisorKiB'] + r['workerKiB'],
                    f'rss: series {r["series"]} has invalid values')
            require(platform != 'darwin' or r['metric'] == DARWIN_RSS, f'rss: series {r["series"]} is not labelled {DARWIN_RSS}')
        counts['rss'] = len(rows)
        rows, keys = keyed(records, 'load', ('series', 'action', 'boundary'))
        require(keys == {(s, a, b) for s in series for a in ('readiness', 'ttfb', 'rss') for b in ('start', 'end')}, 'load: boundaries missing')
        for r in rows:
            require(set(r) == {'type', 'series', 'action', 'boundary', 'at', 'averages'} and utc(r['at']) and isinstance(r['averages'], list) and
                    len(r['averages']) == 3 and all(number(v, 0) for v in r['averages']), f'load: invalid sample {r!r:.160}')
        counts['load'] = len(rows)
        rows, keys = keyed(records, 'environment', ('series',))
        require(keys == {(s,) for s in series}, 'environment: records missing')
        for r in rows:
            require(set(r) == {'type', 'series', 'supervisor', 'readiness', 'workerPort'} and port(r['workerPort']) and
                    exact_env(r['supervisor'], GATEWAY_ENV, f'environment {r["series"]} supervisor') is None and
                    exact_env(r['readiness'], READINESS_ENV, f'environment {r["series"]} readiness') is None,
                    f'environment: invalid record for series {r["series"]}')
        counts['environment'] = len(rows)
        counts['disconnect'] = check_disconnects(records)
        counts['upgrade'] = check_upgrades(records)
        topologies = TOPOLOGIES
        posts = SETTINGS['series'] * (SETTINGS['warmups'] + SETTINGS['ttfbRuns'])
        require(end['usagePosts'] == posts, f'usage collector received {end["usagePosts"]} posts, expected {posts}')
    else:
        counts['half-close'] = check_half_close(records)
        topologies = ('relayed',)
    rows, keys = keyed(records, 'probe-environment', ('topology',))
    require(keys == {(t,) for t in topologies}, 'probe-environment: records missing')
    for r in rows:
        require(set(r) == {'type', 'topology', 'gateway', 'clientPort', 'workerPort'} and port(r['clientPort']) and
                (port(r['workerPort']) if r['topology'] == 'relayed' else r['workerPort'] is None) and
                exact_env(r['gateway'], GATEWAY_ENV, f'probe-environment {r["topology"]}') is None,
                f'probe-environment: invalid record for {r["topology"]}')
    counts['probe-environment'] = len(rows)
    other = {r['type'] for r in records} - set(counts)
    require(not other, f'unexpected record types: {sorted(other)}')
    require(sum(counts.values()) == len(records), 'record count does not match the checked observations')
    require(sum(r['type'] == 'run' for r in records) == 1, 'more than one run record')
    return counts


def nearest_rank(sorted_values, fraction):
    return sorted_values[math.ceil(fraction * len(sorted_values)) - 1]


def median(sorted_values):
    middle = len(sorted_values) // 2
    if len(sorted_values) % 2:
        return sorted_values[middle]
    return (sorted_values[middle - 1] + sorted_values[middle]) / 2


def summary(records, platform):
    check(records, 'full', platform)
    print('| Series | Metric | Samples | Min (ms) | Median (ms) | p95 or p99 (ms) | Max (ms) |')
    print('| --- | --- | --- | --- | --- | --- | --- |')
    tails = {'readiness': [], 'ttfb': []}
    for series in range(1, SETTINGS['series'] + 1):
        for kind, label, value, fraction in (('readiness', 'Readiness', 'wallMs', 0.95), ('ttfb', 'TTFB', 'ttfbMs', 0.99)):
            values = sorted(r[value] for r in records if r['type'] == kind and r['series'] == series and not r['warmup'])
            tails[kind].append(nearest_rank(values, fraction))
            print(f'| {series} | {label} | {len(values)} | {values[0]:.3f} | {median(values):.3f} | '
                  f'{tails[kind][-1]:.3f} | {values[-1]:.3f} |')
    label = 'ps RSS' if platform == 'darwin' else 'RSS'
    print()
    print(f'| Series | Idle (s) | Supervisor {label} (KiB) | Worker {label} (KiB) | Sum (KiB) |')
    print('| --- | --- | --- | --- | --- |')
    sums = []
    for r in sorted((r for r in records if r['type'] == 'rss'), key=lambda r: r['series']):
        sums.append(r['sumKiB'])
        print(f'| {r["series"]} | {r["idleMs"] / 1000:.3f} | {r["supervisorKiB"]} | {r["workerKiB"]} | {r["sumKiB"]} |')
    print()
    print('| Statistic | Across-series median | Across-series min–max |')
    print('| --- | --- | --- |')
    for name, values, form in (('Readiness p95 (ms)', tails['readiness'], '.3f'), ('TTFB p99 (ms)', tails['ttfb'], '.3f'),
                               (f'Idle {label} sum (KiB)', sums, 'd')):
        ordered = sorted(values)
        print(f'| {name} | {ordered[len(ordered) // 2]:{form}} | {ordered[0]:{form}}–{ordered[-1]:{form}} |')


def read_capped(path):
    # No symlink is followed and a FIFO or device cannot block the open; only
    # a regular file within the cap is read.
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as error:
        raise Invalid(f'cannot open {path}: {error.strerror}')
    with os.fdopen(fd, 'rb') as file:
        info = os.fstat(fd)
        require(stat.S_ISREG(info.st_mode), f'{path} is not a regular file')
        require(info.st_size <= MAX_INPUT_BYTES, f'{path} exceeds the input size limit')
        data = file.read(MAX_INPUT_BYTES + 1)
    require(len(data) <= MAX_INPUT_BYTES, f'{path} exceeds the input size limit')
    return data


def unframe(output):
    lines = [line for line in output.splitlines() if line.startswith(b'NODE-BENCH-V1 ')]
    require(len(lines) == 1, f'expected exactly one evidence frame, found {len(lines)}')
    parts = lines[0].split(b' ')
    require(len(parts) == 3, 'malformed evidence frame')
    require(len(parts[2]) <= MAX_FRAME_BYTES, 'the evidence frame exceeds the size limit')
    try:
        payload = base64.b64decode(parts[2], validate=True)
    except binascii.Error as error:
        raise Invalid(f'frame is not Base64: {error}')
    digest = hashlib.sha256(payload).hexdigest()
    require(digest.encode() == parts[1], 'damaged evidence frame')
    inflater = zlib.decompressobj(wbits=31)
    try:
        raw = inflater.decompress(payload, MAX_DECODED_BYTES + 1)
    except zlib.error as error:
        raise Invalid(f'frame is not gzip: {error}')
    require(len(raw) <= MAX_DECODED_BYTES and not inflater.unconsumed_tail, 'decoded records exceed the size limit')
    require(inflater.eof and not inflater.unused_data, 'frame holds more than one complete gzip member')
    return digest, raw


def main():
    args = sys.argv[2:]
    usage = ('usage: baseline-bench verify --platform linux|darwin [--job <label>] full|half-close <run output> [<new JSON Lines file>] | '
             'check --platform linux|darwin [--job <label>] full|half-close <JSON Lines file> | summary --platform linux|darwin <JSON Lines file>; '
             'a <label> or path starting with "--" is reserved')
    if len(args) < 3 or args[1] != '--platform' or args[2] not in ('linux', 'darwin'):
        raise Invalid(usage)
    command, platform, rest = args[0], args[2], args[3:]
    job = None
    if command in ('verify', 'check') and rest[:1] == ['--job']:
        # The value must be a label, not the next option word.
        if len(rest) < 2 or not rest[1] or rest[1].startswith('--'):
            raise Invalid(usage)
        job, rest = rest[1], rest[2:]
    names = {'linux': 'Linux', 'darwin': 'macOS'}
    # An option word where a path belongs is a mistake, never a filename;
    # write ./--name for a file that really starts with two dashes.
    paths = rest[1:] if command in ('verify', 'check') else rest
    if any(path.startswith('--') for path in paths):
        raise Invalid(usage)
    if command == 'verify' and len(rest) in (2, 3) and rest[0] in ('full', 'half-close'):
        # An existing output file is never replaced, not even by the same bytes.
        require(len(rest) == 2 or not os.path.lexists(rest[2]), f'{rest[-1]} exists; the decoded records go to a new file')
        digest, raw = unframe(read_capped(rest[1]))
        counts = check(decode(raw), rest[0], platform, job)
        if len(rest) == 3:
            try:
                with open(rest[2], 'xb') as file:
                    file.write(raw)
            except FileExistsError:
                raise Invalid(f'{rest[2]} exists; the decoded records go to a new file')
        print(f'Verified {rest[0]} run on {names[platform]}: {json.dumps(counts, sort_keys=True)}')
        print('Compressed frame SHA-256:', digest)
        print('Raw JSON Lines SHA-256:', hashlib.sha256(raw).hexdigest())
    elif command == 'check' and len(rest) == 2 and rest[0] in ('full', 'half-close'):
        raw = read_capped(rest[1])
        counts = check(decode(raw), rest[0], platform, job)
        print(f'Checked {rest[0]} run on {names[platform]}: {json.dumps(counts, sort_keys=True)}')
        print('Raw JSON Lines SHA-256:', hashlib.sha256(raw).hexdigest())
    elif command == 'summary' and len(rest) == 1:
        summary(decode(read_capped(rest[0])), platform)
    else:
        raise Invalid(usage)


try:
    main()
except Invalid as error:
    sys.exit(f'baseline-bench: {error}')

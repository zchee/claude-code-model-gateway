set -euo pipefail
fail() { printf 'baseline-node: %s\n' "$*" >&2; exit 1; }
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
"$root/hack/venue-check"
if command -v claude >/dev/null; then fail 'claude resolves on venue PATH'; fi
plugin=$("$root/hack/pinned-source")/plugins/model-gateway
work=$(mktemp -d "$root/.cache/baseline.XXXXXXXX")
# A short path matters: fixtures bind Unix sockets below os.tmpdir().
tmp=$(mktemp -d "${root%/*}/t.XXXXXX")
mkdir "$work/home" "$work/bin"
# PATH: attested toolchain and system utilities. HOME: no user npm config.
# TMPDIR: private fixture tree. npm_config_cache: provisioned venue dependency cache.
clean=(env -i "PATH=$PATH" "HOME=$work/home" "TMPDIR=$tmp" "npm_config_cache=${npm_config_cache:?missing venue npm cache}")
# Linux port ownership uses lsof and ps; the CLI extracts tar.gz releases.
# The picker calls which; generated launchers and POSIX fixtures use env, sh
# and touch. Git materializes the pin. The proxy and Claude are fixture-owned.
"${clean[@]}" python3 -I - <<'PY' > "$work/tools.json"
import json, shutil, subprocess, sys
from pathlib import Path

tools = {}
for tool in ('lsof', 'ps', 'tar', 'gzip', 'which', 'sh', 'env', 'touch', 'git', 'node', 'npm'):
    path = shutil.which(tool)
    if not path: sys.exit(f'baseline-node: required tool not found on PATH: {tool}')
    if tool in ('node', 'npm'):
        version = subprocess.check_output([path, '--version'], text=True).strip()
    else:
        # Debian's which and dash lack --version. Query the actual executable's
        # owning package, including the pre-usrmerge spelling used by dpkg.
        real = str(Path(path).resolve(strict=True))
        for candidate in dict.fromkeys((real, real.removeprefix('/usr') if real.startswith('/usr/') else real)):
            query = subprocess.run(['dpkg-query', '-S', candidate], capture_output=True, text=True)
            owners = [s[:-len(': ' + candidate)] for s in query.stdout.splitlines() if s.endswith(': ' + candidate)]
            if query.returncode == 0 and len(owners) == 1: break
        else: sys.exit(f'baseline-node: cannot identify required tool {tool} at {path}')
        version = subprocess.check_output(['dpkg-query', '-W', '-f', '${binary:Package} ${Version}', owners[0]], text=True).strip()
    if not version or '\n' in version: sys.exit(f'baseline-node: invalid version for {tool}: {version!r}')
    tools[tool] = dict(path=path, version=version)
print(json.dumps(tools))
PY
"${clean[@]}" npm --prefix "$plugin" ci --ignore-scripts --no-audit --no-fund
node=$(command -v node)
ajv=$("${clean[@]}" "$node" -p 'require(process.argv[1]).version' "$plugin/node_modules/ajv/package.json")
[[ $ajv == 8.20.0 ]] || fail "wrong installed ajv: $ajv"

# Inject reporter switches only in the manifest's outer node --test invocation.
# NODE_OPTIONS would also change the harness self-test's nested TAP runner.
{
    # Expand the positional parameters in the dispatcher, not while writing it.
    # shellcheck disable=SC2016
    printf '%s\n' '#!/bin/bash' 'set -eu' 'if [[ ${1-} == --require && ${2-} == ./test/isolate-home.js && ${3-} == --test ]]; then'
    printf '  exec %q %q %q "$@"\n' "$node" "--test-reporter=$root/hack/baseline-node-reporter.mjs" "--test-reporter-destination=$work/events.jsonl"
    printf 'fi\nexec %q "$@"\n' "$node"
} > "$work/bin/node"
chmod +x "$work/bin/node"
clean+=("PATH=$work/bin:$PATH")
# npm adds package and ancestor bin directories for lifecycle scripts.
script_path=$("${clean[@]}" npm --prefix "$plugin" --silent run env | perl -ne 'print $1 if /^PATH=(.*)$/')
[[ -n $script_path ]] || fail 'npm did not report the lifecycle PATH'
if PATH="$script_path" command -v claude >/dev/null; then fail 'claude resolves on npm script PATH'; fi
[[ $(PATH="$script_path" command -v node) == "$work/bin/node" ]] || fail 'npm script PATH shadows reporter dispatcher'

# Process identity survives renames and reparenting. Check the executable only
# for a potential session bus, never process arguments or environments.
snapshot() {
    python3 -I - "$1" "$work/before" <<'PY'
from pathlib import Path
import json, os, re, sys
mode, before = sys.argv[1:]
uid = os.getuid()
user_slice = f'/user.slice/user-{uid}.slice/'
def cgroup(p):
    paths = [s[3:] for s in (p / 'cgroup').read_text().splitlines() if s.startswith('0::/')]
    if len(paths) != 1: raise ValueError(f'{p}: expected one unified cgroup v2 path')
    return paths[0]
def identity(p):
    try:
        name, fields = (p / 'stat').read_text().rsplit(')', 1)
        fields = fields.split()
        if fields[0] != 'Z': return (int(p.name), int(fields[19]), name.partition('(')[2])
    except (FileNotFoundError, ProcessLookupError): return None

session = cgroup(Path('/proc/self'))
if not re.fullmatch(re.escape(user_slice) + r'session-[^/]+\.scope(?:/.*)?', session):
    sys.exit(f'expected a systemd login session scope in cgroup v2, got {session!r}')
old = set(map(tuple, json.loads(Path(before).read_text()))) if mode == 'after' else set()
current, excluded, leftovers = [], [], []
for p in sorted(Path('/proc').glob('[0-9]*')):
    try:
        if int(p.name) == os.getpid() or p.stat().st_uid != uid: continue
    except (FileNotFoundError, ProcessLookupError): continue
    item = identity(p)
    if not item: continue
    current.append(item[:2])
    if mode == 'before' or item[:2] in old: continue
    pid, start, name = item
    try:
        group = cgroup(p)
        bus = (name == 'dbus-daemon' and group.startswith(f'{user_slice}user@{uid}.service/')
               and group.endswith('/dbus.service') and Path(os.readlink(p / 'exe')).name == 'dbus-daemon')
    except (OSError, ValueError) as err:
        if (identity(p) or ())[:2] != item[:2]: continue
        raise SystemExit(f'cannot attribute live PID {pid} (start tick {start}): {err}')
    if (identity(p) or ())[:2] != item[:2]: continue
    dest = excluded if bus else leftovers
    dest.append(dict(pid=pid, start_tick=start, name=name, cgroup=group))
print(json.dumps(current if mode == 'before' else dict(excluded=excluded, leftovers=leftovers)))
PY
}
"$root/hack/pinned-source" --print-pin > "$work/pin"
"${clean[@]}" "$node" --version > "$work/node-version"
"${clean[@]}" npm --version > "$work/npm-version"
printf '%s\n' "$ajv" > "$work/ajv-version"
"${clean[@]}" "$node" -p 'require(process.argv[1]).scripts.test' "$plugin/package.json" > "$work/command"
snapshot before > "$work/before"
suite_pid=''
# Called by the signal trap, not on the ordinary completion path.
# shellcheck disable=SC2329
on_interrupt() {
    trap '' HUP INT TERM
    printf 'baseline-node: interrupted; no publishable evidence; post-run process check:\n' >&2
    if [[ -n $suite_pid && $(jobs -pr) == "$suite_pid" ]]; then
        kill -TERM -- "-$suite_pid" 2>/dev/null || :
    fi
    snapshot after >&2 || printf 'baseline-node: interrupted process check failed\n' >&2
    exit 1
}
trap on_interrupt HUP INT TERM
date -u '+%Y-%m-%dT%H:%M:%SZ' > "$work/start"
# A separate job group lets a signal interrupt wait immediately, and lets us
# terminate that group without signalling other processes in the login session.
set -m
"${clean[@]}" npm --prefix "$plugin" test &
suite_pid=$!
set +m
rc=0; wait "$suite_pid" || rc=$?
suite_pid=''
printf '%d\n' "$rc" > "$work/exit"
date -u '+%Y-%m-%dT%H:%M:%SZ' > "$work/end"
# The command, dates, exit and raw events are durable before these checks.
process_rc=0; snapshot after > "$work/processes" 2> "$work/process-error" || process_rc=$?
venue_rc=0; "$root/hack/venue-check" > "$work/venue-check" 2>&1 || venue_rc=$?
frame_rc=0
python3 -I - "$work" "$plugin" "$process_rc" "$venue_rc" > "$work/frame" <<'PY' || frame_rc=$?
import base64, gzip, hashlib, json, sys
from collections import Counter
from pathlib import Path
work, plugin = map(Path, sys.argv[1:3])
def read(name): return (work / name).read_text().strip()
commit, root_tree, plugin_tree = read('pin').split('\t')
run = dict(commit=commit, root_tree=root_tree, plugin_tree=plugin_tree,
           node=read('node-version'), npm=read('npm-version'), ajv=read('ajv-version'),
           tools=json.loads(read('tools.json')), command=read('command'), invocation='npm test', started=read('start'),
           ended=read('end'), exit=int(read('exit')))
events, errors = [], []
try:
    for line in read('events.jsonl').splitlines():
        event = json.loads(line)
        if event['type'] == 'baseline:environment':
            run['bus_environment_present'] = {k: v for k, v in event.items() if k != 'type'}
        else: events.append(event)
except (OSError, ValueError, KeyError) as err: errors.append(f'reporter stream: {err}')
files = {p.relative_to(plugin).as_posix() for p in (plugin / 'test').glob('*.test.js')}
ends = Counter(e.get('file') for e in events if e['type'] == 'test:summary')
complete = len(files) == 57 and ends == Counter([None, *files])
if not complete: errors.append(f'incomplete file summaries: {dict(ends)}')
processes = json.loads(read('processes')) if sys.argv[3] == '0' else {}
if not processes: errors.append('process check: ' + read('process-error'))
elif processes['leftovers']: errors.append(f"new session processes: {processes['leftovers']}")
if sys.argv[4] != '0': errors.append('venue check: ' + read('venue-check'))
run['processes'] = processes
run['verdicts'] = dict(suite_exit=run['exit'], files_complete=complete,
                       processes_clean=bool(processes) and not processes['leftovers'],
                       venue_clean=sys.argv[4] == '0', errors=errors)
(work / 'run.json').write_text(json.dumps(run) + '\n')
payload = gzip.compress(json.dumps(dict(run=run, events=events)).encode(), mtime=0)
print('BASELINE-NODE-V1', hashlib.sha256(payload).hexdigest(), base64.b64encode(payload).decode(), flush=True)
if errors: sys.exit('baseline-node: ' + '; '.join(errors))
PY
# Do not send bytes from a still-running (and possibly interrupted) collector.
if IFS= read -r frame < "$work/frame"; then printf '%s\n' "$frame"; fi
(( frame_rc == 0 )) || exit "$frame_rc"
exit "$rc"

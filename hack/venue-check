if [[ ${BASH_SOURCE[0]} == "$0" ]]; then set -euo pipefail; fi

venue_refuse() {
    printf 'not a test venue: %s\n' "$1" >&2
    exit 97
}

venue_home() {
    local os home
    os=$(uname -s 2>/dev/null) || venue_refuse 'cannot establish account home'
    case $os in
        Linux) set -- /usr/bin/getent passwd "$EUID" ;;
        Darwin) set -- /usr/bin/dscacheutil -q user -a uid "$EUID" ;;
        *) venue_refuse 'cannot establish account home' ;;
    esac
    home=$(
        set -o pipefail
        # Keep the record on fd 3 and count stderr bytes separately. Even a
        # newline-only warning must invalidate an otherwise successful lookup.
        { n=$(LC_ALL=C "$@" 2>&1 >&3 | wc -c) && (( n == 0 )); } 3>&1 |
            perl -e '
                my ($os,$uid) = @ARGV;
                local $/; my $record = <STDIN> // "";
                exit 1 unless $record =~ s/\n\z// && $record !~ /[\r\0]/;
                if ($os eq "Linux") {
                    my @f = split /:/,$record,-1;
                    exit 1 unless $record !~ /\n/ && @f == 7 && $f[2] eq $uid && length $f[5];
                    print $f[5];
                } else {
                    $record =~ s/\n\z//; # optional trailing record separator
                    my %f;
                    for (split /\n/,$record,-1) {
                        exit 1 unless /\A(name|password|uid|gid|dir|shell|gecos): (.*)\z/ && !exists $f{$1};
                        $f{$1}=$2;
                    }
                    exit 1 unless keys(%f)==7 && $f{uid} eq $uid && length $f{dir};
                    print $f{dir};
                }
            ' "$os" "$EUID"
    ) || venue_refuse 'cannot establish account home'
    if [[ $home != / && ( $home != /* || $home == */ || $home == *//* || /$home/ == */./* || /$home/ == */../* ) ]]; then
        venue_refuse 'account home is not a clean absolute path'
    fi
    printf '%s\n' "$home"
}

venue_file_kind() {
    # Shell file tests do not distinguish ENOENT from EACCES or ELOOP.
    perl -MFcntl=:mode -MErrno=ENOENT -e '
        my @s = lstat($ARGV[0]);
        if (@s) { print S_ISREG($s[2]) ? "regular" : "other" }
        elsif ($! == ENOENT) { print "absent" } else { exit 1 }
    ' "$1" 2>/dev/null
}

venue_state_clear() {
    local kind
    kind=$(venue_file_kind "$1/.claude/model-gateway") || venue_refuse 'cannot inspect gateway state'
    [[ $kind == absent ]] || venue_refuse 'gateway state present'
}

darwin_busy_port() {
    # Unprivileged lsof sees this user's sockets. A visible canary proves the
    # listing works before we trust it to rule out a gateway owned by this user.
    LC_ALL=C perl - "$@" 2>/dev/null <<'PERL'
use strict;
use warnings;
use Errno qw(EADDRINUSE);
use IPC::Open3;
use Socket qw(AF_INET AF_INET6 SOCK_STREAM inet_pton sockaddr_in);
use Symbol qw(gensym);
# The kernel's ephemeral range is configurable and may include a gateway port.
socket(my $canary, AF_INET, SOCK_STREAM, 0) or die;
my ($port, %tried);
for (1..16) {
    my $candidate = 20000 + int rand 40001;
    next if $tried{$candidate}++;
    if (bind($canary, sockaddr_in($candidate, inet_pton(AF_INET,'127.0.0.1')))) {
        $port=$candidate; last;
    }
    die unless $! == EADDRINUSE;
}
die unless defined $port;
listen($canary,1) or die;
my $errors = gensym;
my $child = open3(undef, my $out, $errors, '/usr/sbin/lsof', '-nP',
    '-iTCP:'.join(',', $port, @ARGV), '-sTCP:LISTEN', '-Fpfn');
my (%busy, $seen, $owner); my $field='p';
my $ok = eval {
    local $SIG{ALRM} = sub { die 'timeout' }; alarm 10;
    while (<$out>) {
        chomp;
        if (/^p([0-9]+)$/ && ($field eq 'p' || $field eq 'pf')) { $owner=$1; $field='f'; next; }
        if (/^f[0-9]+$/ && ($field eq 'f' || $field eq 'pf')) { $field='n'; next; }
        die unless $field eq 'n' && /^n(.*):([0-9]+)$/;
        my ($address,$n) = ($1,$2);
        die unless $n > 0 && $n <= 65535;
        if ($address =~ /^\[([^\]]+)\]$/) {
            my $ip=$1; $ip =~ s/%[\w.-]+$//; die unless inet_pton(AF_INET6,$ip);
        } else { die unless $address eq '*' || inet_pton(AF_INET,$address); }
        $seen=1 if $owner == $$ && $address eq '127.0.0.1' && $n == $port;
        $busy{$n}=1 unless $owner == $$ && $n == $port;
        $field='pf';
    }
    die if <$errors> || $field ne 'pf' || !$seen;
    waitpid($child,0) == $child or die; $child=undef; die if $? != 0;
    1;
};
alarm 0;
unless ($ok) { if (defined $child) { kill 'KILL',$child; waitpid($child,0); } exit 1; }
print((grep { $busy{$_} } @ARGV)[0] // 0);
PERL
}

venue_ports_clear() {
    local os sockets port busy
    os=$(uname -s 2>/dev/null) || venue_refuse 'cannot inspect TCP port 18764'
    if [[ $os == Darwin ]]; then
        busy=$(darwin_busy_port 18764 18765) || venue_refuse 'cannot inspect TCP port 18764'
        [[ $busy == 0 ]] || venue_refuse "TCP port $busy has a listener"
        return
    fi
    [[ $os == Linux ]] || venue_refuse 'cannot inspect TCP port 18764'
    for port in 18764 18765; do
        sockets=$(LC_ALL=C ss -ltn "sport = :$port" 2>&1) || venue_refuse "cannot inspect TCP port $port"
        busy=$(perl -MSocket=AF_INET,AF_INET6,inet_pton -e '
            my $p = shift; my $header = <STDIN> // "";
            exit 1 unless $header =~ /^State\s+Recv-Q\s+Send-Q\s+Local Address:Port\s+Peer Address:Port\s*$/;
            sub endpoint {
                my ($field) = @_; return unless $field =~ /^(.*):(\d+|\*)$/;
                my ($ip,$n) = ($1,$2); $ip =~ s/^\[([^\]]+)\]$/$1/; $ip =~ s/%[\w.-]+$//;
                return unless $ip eq "*" || inet_pton(AF_INET,$ip) || inet_pton(AF_INET6,$ip);
                return $n if $n eq "*" || $n <= 65535; return;
            }
            my $busy=0; while (<STDIN>) {
                my @f=split; exit 1 unless @f==5 && $f[0] eq "LISTEN" && $f[1]=~/^\d+$/ && $f[2]=~/^\d+$/ && (endpoint($f[3]) // "") eq $p && defined endpoint($f[4]);
                $busy=1;
            } print $busy;
        ' "$port" <<< "$sockets") || venue_refuse "cannot inspect TCP port $port"
        [[ $busy == 0 ]] || venue_refuse "TCP port $port has a listener"
    done
}

venue_require() {
    local home=$1 kind
    kind=$(venue_file_kind "$home/.model-gateway-test-venue") || venue_refuse 'cannot inspect attestation'
    case $kind in
        absent) venue_refuse 'attestation missing' ;;
        regular) ;;
        *) venue_refuse 'attestation is not a regular file' ;;
    esac
    venue_state_clear "$home"
    venue_ports_clear
}

venue_attest() {
    local file=$1/.model-gateway-test-venue timestamp host
    if [[ -f $file && ! -L $file ]]; then return; fi
    [[ ! -e $file && ! -L $file ]] || venue_refuse 'invalid attestation file'
    timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || venue_refuse 'cannot date attestation'
    host=$(hostname) || venue_refuse 'cannot identify attestation origin'
    (umask 077; set -C; printf '%s\t%s\t%s\n' "$timestamp" "$host" "$2" > "$file") || venue_refuse 'cannot create attestation file'
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    [[ $# == 0 ]] || venue_refuse 'unexpected arguments'
    home=$(venue_home) || exit $?
    venue_require "$home"
fi
